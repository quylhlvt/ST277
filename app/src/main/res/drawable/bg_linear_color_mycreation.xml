<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lớp 1: bóng đổ (đặt dưới cùng, lệch xuống 1 chút) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/dimension_10" />
            <solid android:color="@color/app_color2" />
        </shape>
    </item>

    <!-- Lớp 2: nền chính -->
    <item
        android:bottom="@dimen/dimension_1">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/dimension_10" />
            <solid android:color="@color/app_color3" />
        </shape>
    </item>

    <!-- Lớp 3: viền -->
    <item
        android:bottom="@dimen/dimension_4">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/dimension_10" />
            <solid android:color="@color/app_color4" />
        </shape>
    </item>

    <!-- Lớp 4: highlight/inner glow, thu nhỏ vào trong -->
    <item
        android:bottom="@dimen/dimension_5">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/dimension_10" />
            <gradient
                android:startColor="#FABB73"
                android:centerColor="#FFA750"
                android:endColor="#D27433"
                android:angle="270" />
        </shape>
    </item>

</layer-list>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToOutline="false"
        android:clipToPadding="false"
        android:layout_marginBottom="@dimen/dimension_16">


    <com.quylh.gradientstrokelayout.GradientStrokeFrameLayout
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintDimensionRatio="3.28:0.56"
            android:id="@+id/imgLangFor"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:gslStrokeWidth="@dimen/dimension_2"
            app:gslCornerRadius="@dimen/dimension_10"
            app:gslStartColor="@color/language_stroke_start"
            app:gslCenterColor="@color/language_stroke_center"
            app:gslEndColor="@color/language_stroke_end"
            app:gslOrientation="topToBottom">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/bg"
                    android:layout_width="match_parent"
                android:background="@color/white4"
                    android:layout_height="match_parent">
                <View
                        android:id="@+id/top1"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dimension_0"
                        app:layout_constraintDimensionRatio="3.2:0.09"
                        app:layout_constraintTop_toTopOf="parent"/>

                <View
                        android:id="@+id/bottom1"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dimension_0"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintDimensionRatio="3.2:0.09"/>
                <View
                        android:id="@+id/top2"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dimension_0"
                        app:layout_constraintDimensionRatio="3.28:0.16"
                        app:layout_constraintTop_toTopOf="parent"/>

                <View
                        android:id="@+id/bottom2"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dimension_0"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintDimensionRatio="3.28:0.16"/>

                <View
                        android:id="@+id/start1"
                        android:layout_width="@dimen/dimension_0"
                        android:layout_height="match_parent"
                        app:layout_constraintDimensionRatio="1.6:5.6"
                        app:layout_constraintStart_toStartOf="parent"/>

                <View
                        android:id="@+id/end1"
                        android:layout_width="@dimen/dimension_0"
                        android:layout_height="match_parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintDimensionRatio="1.2:4"/>


                <ImageView
                        android:id="@+id/imvFlag"
                        android:layout_width="@dimen/dimension_0"
                        android:layout_height="@dimen/dimension_0"
                        android:src="@drawable/ic_flag_english"
                        app:layout_constraintBottom_toTopOf="@+id/bottom1"
                        app:layout_constraintDimensionRatio="1:1"
                        app:layout_constraintStart_toEndOf="@+id/start1"
                        app:layout_constraintTop_toBottomOf="@+id/top1"/>

                <ImageView
                        android:id="@+id/btnRadio"
                        android:layout_width="@dimen/dimension_0"
                        android:layout_height="@dimen/dimension_0"
                        android:src="@drawable/ic_select_lang"
                        app:layout_constraintBottom_toTopOf="@+id/bottom2"
                        app:layout_constraintDimensionRatio="1:1"
                        app:layout_constraintEnd_toStartOf="@+id/end1"
                        app:layout_constraintTop_toBottomOf="@+id/top2"/>

                <com.warrior.oc.ca.core.widget.GradientTextView
                        android:id="@+id/tvLang"
                        style="@style/single_marquee"
                        android:layout_width="@dimen/dimension_0"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dimension_12"
                        android:fontFamily="@font/lilita_one_regular"
                        android:gravity="start|center_vertical"
                        android:text="@string/language"
                        android:textSize="@dimen/text_size_16"
                        app:gradientStartColor="@color/language_stroke_start"
                        app:gradientEndColor="@color/language_stroke_end2"
                        app:layout_constraintBottom_toTopOf="@+id/bottom1"
                        app:layout_constraintEnd_toStartOf="@+id/btnRadio"
                        app:layout_constraintStart_toEndOf="@+id/imvFlag"
                        app:layout_constraintTop_toBottomOf="@+id/top1"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
    </com.quylh.gradientstrokelayout.GradientStrokeFrameLayout>


</androidx.constraintlayout.widget.ConstraintLayout>

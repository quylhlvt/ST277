<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToOutline="false"
        android:clipToPadding="false"
        android:layout_marginBottom="@dimen/dimension_16">


    <com.google.android.material.card.MaterialCardView
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintDimensionRatio="3.28:0.52"
            android:id="@+id/imgLangFor"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:strokeColor="@color/black"
            app:strokeWidth="@dimen/dimension_0"
            app:cardCornerRadius="@dimen/dimension_10"
            app:cardBackgroundColor="@color/app_color2">
        <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="@dimen/dimension_1"
                app:strokeWidth="@dimen/dimension_0"
                app:cardCornerRadius="@dimen/dimension_10"
                app:cardBackgroundColor="@color/app_color3">
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="@dimen/dimension_3"
                app:strokeWidth="@dimen/dimension_0"
                app:cardCornerRadius="@dimen/dimension_10"
                app:cardBackgroundColor="@color/app_color4">
                <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="@dimen/dimension_1"
                app:strokeWidth="@dimen/dimension_0"
                app:cardCornerRadius="@dimen/dimension_10"
                app:cardBackgroundColor="@color/transparent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/bg"
                    android:layout_width="match_parent"
                android:background="@drawable/bg_linear_color"
                    android:layout_height="match_parent">
                <View
                        android:id="@+id/top1"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dimension_0"
                        app:layout_constraintDimensionRatio="3.2:0.09"
                        app:layout_constraintTop_toTopOf="parent"/>

                <View
                        android:id="@+id/bottom1"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dimension_0"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintDimensionRatio="3.2:0.09"/>
                <View
                        android:id="@+id/top2"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dimension_0"
                        app:layout_constraintDimensionRatio="3.2:0.14"
                        app:layout_constraintTop_toTopOf="parent"/>

                <View
                        android:id="@+id/bottom2"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dimension_0"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintDimensionRatio="3.2:0.14"/>

                <View
                        android:id="@+id/start1"
                        android:layout_width="@dimen/dimension_0"
                        android:layout_height="match_parent"
                        app:layout_constraintDimensionRatio="1.2:4"
                        app:layout_constraintStart_toStartOf="parent"/>

                <View
                        android:id="@+id/end1"
                        android:layout_width="@dimen/dimension_0"
                        android:layout_height="match_parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintDimensionRatio="1.2:4"/>


                <ImageView
                        android:id="@+id/imvFlag"
                        android:layout_width="@dimen/dimension_0"
                        android:layout_height="@dimen/dimension_0"
                        android:src="@drawable/ic_flag_english"
                        app:layout_constraintBottom_toTopOf="@+id/bottom1"
                        app:layout_constraintDimensionRatio="1:1"
                        app:layout_constraintStart_toEndOf="@+id/start1"
                        app:layout_constraintTop_toBottomOf="@+id/top1"/>

                <ImageView
                        android:id="@+id/btnRadio"
                        android:layout_width="@dimen/dimension_0"
                        android:layout_height="@dimen/dimension_0"
                        android:src="@drawable/ic_select_lang"
                        app:layout_constraintBottom_toTopOf="@+id/bottom2"
                        app:layout_constraintDimensionRatio="1:1"
                        app:layout_constraintEnd_toStartOf="@+id/end1"
                        app:layout_constraintTop_toBottomOf="@+id/top2"/>

                <TextView
                        android:id="@+id/tvLang"
                        style="@style/single_marquee"
                        android:layout_width="@dimen/dimension_0"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dimension_12"
                        android:fontFamily="@font/jockey_one_regular"
                        android:gravity="start|center_vertical"
                        android:text="@string/language"
                        android:textColor="@color/app_color"
                        android:textSize="@dimen/text_size_20"
                        app:layout_constraintBottom_toTopOf="@+id/bottom1"
                        app:layout_constraintEnd_toStartOf="@+id/btnRadio"
                        app:layout_constraintStart_toEndOf="@+id/imvFlag"
                        app:layout_constraintTop_toBottomOf="@+id/top1"
                        app:outerStrokeColor="@color/app_color"
                        app:outerStrokeWidth="@dimen/dimension_1"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>
        </com.google.android.material.card.MaterialCardView>
        </com.google.android.material.card.MaterialCardView>

    </com.google.android.material.card.MaterialCardView>


</androidx.constraintlayout.widget.ConstraintLayout>

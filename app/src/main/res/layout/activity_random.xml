<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_color2"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context="com.anime.oc.characters.avatar.ui.main.random.RandomActivity">


    <FrameLayout
        android:id="@+id/layoutActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/actionBar"
            layout="@layout/layout_actionbar" />
    </FrameLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/imgRandom"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimension_0"
        android:layout_marginTop="@dimen/dimension_10"
        android:layout_marginHorizontal="@dimen/dimension_16"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutActionBar">
        <com.google.android.material.card.MaterialCardView
            android:layout_width="@dimen/dimension_0"
            android:layout_height="@dimen/dimension_0"
            app:cardBackgroundColor="@color/app_color2"
            app:cardCornerRadius="@dimen/dimension_20"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeColor="@color/app_color"
            app:strokeWidth="@dimen/dimension_3">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_marginHorizontal="@dimen/dimension_6"
                android:layout_marginTop="@dimen/dimension_6"
                android:layout_marginBottom="@dimen/dimension_8"
                android:layout_height="match_parent">
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    app:cardBackgroundColor="@color/white"
                    app:strokeColor="@color/app_color4"
                    app:cardCornerRadius="@dimen/dimension_14"
                    app:strokeWidth="@dimen/dimension_0"
                    android:layout_height="match_parent">
                    <ImageView
                        android:elevation="@dimen/dimension_2"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:foreground="@drawable/forgound_random"
                        android:id="@+id/imageGif"/>
                    <ImageView
                        android:elevation="@dimen/dimension_1"
                        android:id="@+id/imvImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:foreground="@drawable/forgound_random"
                        android:src="@drawable/img_permission" />
                </com.google.android.material.card.MaterialCardView>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>
    </androidx.constraintlayout.widget.ConstraintLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/lnlBottom"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimension_0"
        app:layout_constraintVertical_bias="0"
        android:layout_marginTop="@dimen/dimension_40"
        android:layout_marginHorizontal="@dimen/dimension_16"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="3.28:0.4"
        app:layout_constraintTop_toBottomOf="@+id/imgRandom">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/btnEdit"
            android:layout_width="@dimen/dimension_0"
            android:layout_height="@dimen/dimension_0"
            android:elevation="@dimen/dimension_2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1.54:0.44"
            app:layout_constraintEnd_toStartOf="@+id/spacer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">


            <ImageView
                android:id="@+id/imgViewFor"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/bg_frame_random" />

            <TextView
                android:id="@+id/txtEdit"
                style="@style/single_marquee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginBottom="@dimen/dimension_10"
                android:fontFamily="@font/pacifico_regular"
                android:gravity="center"
                android:text="@string/edit"
                android:textColor="@color/app_color"
                android:textSize="@dimen/text_size_20" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <Space
            android:id="@+id/spacer"
            android:layout_width="@dimen/dimension_0"
            android:layout_height="match_parent"

            app:layout_constraintDimensionRatio="0.16:0.44"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/random"
            android:layout_width="@dimen/dimension_0"
            android:layout_height="@dimen/dimension_0"

            android:elevation="@dimen/dimension_2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1.54:0.44"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/spacer"
            app:layout_constraintTop_toTopOf="parent">


            <ImageView
                android:id="@+id/imgViewFor1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/bg_frame_random" />

            <TextView
                android:id="@+id/txtRandom"
                style="@style/single_marquee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/pacifico_regular"
                android:gravity="center"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginBottom="@dimen/dimension_8"
                android:text="@string/random"
                android:textColor="@color/app_color"
                android:textSize="@dimen/text_size_20" />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <!--        btnBottomRight-->

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

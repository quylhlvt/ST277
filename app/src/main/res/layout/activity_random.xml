<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
                                                   xmlns:tools="http://schemas.android.com/tools"
                                                   android:layout_width="match_parent"
                                                   android:layout_height="match_parent"
                                                   android:background="@color/app_color2"
                                                   xmlns:app="http://schemas.android.com/apk/res-auto"
                                                   tools:context="com.anime.oc.characters.avatar.ui.main.random.RandomActivity">


    <FrameLayout
            android:id="@+id/layoutActionBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent">

        <include
                android:id="@+id/actionBar"
                layout="@layout/layout_actionbar3"/>
    </FrameLayout>

    <com.google.android.material.card.MaterialCardView
            android:layout_width="@dimen/dimension_0"
            android:layout_height="@dimen/dimension_0"
            android:id="@+id/material"
            app:layout_constraintDimensionRatio="1:1"
            android:layout_margin="@dimen/dimension_16"
            app:cardCornerRadius="@dimen/dimension_4"
            app:strokeColor="@color/black"
            app:cardBackgroundColor="@color/white"
            app:strokeWidth="@dimen/dimension_1"
            app:layout_constraintTop_toBottomOf="@+id/layoutActionBar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintVertical_bias="0">

        <ImageView
                android:id="@+id/imvImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/img_permission"/>
        <ImageView
                android:id="@+id/imageGif"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:visibility="gone"/>
        <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/contrainFirst"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#666666">
            <View
                    android:id="@+id/view1"
                    android:layout_width="@dimen/dimension_0"
                    android:layout_height="@dimen/dimension_0"
                    app:layout_constraintDimensionRatio="3.28:1.36"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>
            <View
                    android:id="@+id/view2"
                    android:layout_width="@dimen/dimension_0"
                    android:layout_height="@dimen/dimension_0"
                    app:layout_constraintDimensionRatio="3.28:0.64"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>
            <TextView
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintTop_toBottomOf="@+id/view2"
                    app:layout_constraintBottom_toTopOf="@+id/imgFirst"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:textSize="@dimen/text_size_16"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:fontFamily="@font/schoolbell_regular"
                    android:text="@string/click_the_random"/>

            <ImageView
                    android:layout_width="@dimen/dimension_0"
                    android:layout_height="@dimen/dimension_0"
                    android:id="@+id/imgFirst"
                    app:layout_constraintDimensionRatio="0.8:1.28"
                    android:src="@drawable/img_first"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/view1"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
            app:layout_constraintTop_toBottomOf="@+id/material"
            app:layout_constraintDimensionRatio="3.28:0.44"
            android:id="@+id/btnRandom"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:strokeColor="@color/black"
            app:strokeWidth="@dimen/dimension_1"
            android:layout_marginTop="@dimen/dimension_24"
            android:layout_marginHorizontal="@dimen/dimension_16"
            app:cardCornerRadius="@dimen/dimension_16"
            app:cardBackgroundColor="@color/app_color2">
        <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/dimension_4"
                app:strokeWidth="@dimen/dimension_0"
                app:cardCornerRadius="@dimen/dimension_14"
                app:cardBackgroundColor="@color/app_color4">
            <TextView
                    android:id="@+id/txtRandom"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:textSize="@dimen/text_size_16"
                    android:textColor="@color/white"
                    android:text="@string/random"
                    android:gravity="center"
                    android:fontFamily="@font/schoolbell_regular"/>
        </com.google.android.material.card.MaterialCardView>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>

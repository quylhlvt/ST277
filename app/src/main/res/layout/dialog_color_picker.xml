<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
    >
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/mater"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dimension_16"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:elevation="@dimen/dimension_2"
            app:cardBackgroundColor="@color/app_color2"
            app:cardCornerRadius="@dimen/dimension_10"
            app:strokeColor="@color/app_color"
            app:strokeWidth="@dimen/dimension_0">
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dimension_2"
                app:cardBackgroundColor="@color/app_color3"
                app:cardCornerRadius="@dimen/dimension_10">
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dimension_4"
                    app:cardBackgroundColor="@color/app_color14"
                    app:cardCornerRadius="@dimen/dimension_10">
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/dimension_1"
                        app:cardBackgroundColor="@color/app_color7"
                        app:cardCornerRadius="@dimen/dimension_10">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/contrainColor"
                            app:layout_constraintTop_toTopOf="parent"
                            android:layout_width="match_parent"
                            android:layout_gravity="center"
                            android:layout_height="wrap_content"
                        >

                            <TextView
                                app:layout_constraintDimensionRatio="3.22:0.6"
                                android:id="@+id/tvTitle"
                                style="@style/single_marquee"
                                android:layout_width="0dp"
                                android:layout_height="@dimen/dimension_0"
                                android:fontFamily="@font/jockey_one_regular"
                                android:gravity="center"
                                android:textColor="@color/app_color"
                                android:paddingBottom="@dimen/dimension_7"
                                android:text="@string/choose_color"
                                android:textSize="@dimen/text_size_24"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                            />

                            <ir.kotlin.quyhcolorpicker.QuylhColorPicker
                                android:id="@+id/colorPickerView"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/dimension_150"
                                android:layout_marginHorizontal="@dimen/dimension_30"
                                android:layout_marginVertical="@dimen/dimension_14"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/tvTitle"/>

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:layout_marginTop="@dimen/dimension_5"
                                android:orientation="vertical"
                                android:paddingBottom="@dimen/dimension_16"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/colorPickerView">

                                <ir.kotlin.quyhcolorpicker.QuylhHueSlider
                                    android:id="@+id/hueSlider"
                                    android:paddingHorizontal="@dimen/dimension_6"
                                    android:layout_marginHorizontal="@dimen/dimension_30"
                                    android:layout_width="match_parent"
                                    app:layout_constraintTop_toTopOf="parent"
                                    android:layout_height="@dimen/dimension_34"/>
                                <androidx.constraintlayout.widget.ConstraintLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/dimension_0"
                                    android:id="@+id/contrain"
                                    android:layout_marginTop="@dimen/dimension_20"
                                    android:layout_marginHorizontal="@dimen/dimension_22"

                                    app:layout_constraintDimensionRatio="2.84:0.44"
                                    app:layout_constraintTop_toBottomOf="@+id/hueSlider"
                                >


                                    <View
                                        android:id="@+id/view4"
                                        android:layout_width="@dimen/dimension_0"
                                        android:layout_height="match_parent"
                                        app:layout_constraintDimensionRatio="1.6:4.4"
                                        app:layout_constraintEnd_toStartOf="@+id/btnSave"
                                        app:layout_constraintStart_toEndOf="@+id/btnCancle"/>


                                    <com.google.android.material.card.MaterialCardView
                                        android:id="@+id/btnCancle"
                                        android:layout_width="@dimen/dimension_0"
                                        android:layout_height="@dimen/dimension_0"
                                        app:layout_constraintTop_toTopOf="parent"
                                        app:layout_constraintBottom_toBottomOf="parent"
                                        app:cardCornerRadius="@dimen/dimension_10"
                                        app:cardBackgroundColor="@color/app_color2"
                                        app:strokeColor="@color/black"
                                        app:strokeWidth="@dimen/dimension_0"
                                        app:layout_constraintDimensionRatio="1.54:0.44"
                                        app:layout_constraintEnd_toStartOf="@+id/view4"
                                        app:layout_constraintStart_toStartOf="parent">

                                        <androidx.cardview.widget.CardView
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent"
                                            android:layout_marginBottom="@dimen/dimension_1"
                                            app:cardBackgroundColor="@color/app_color3"
                                            app:cardCornerRadius="@dimen/dimension_10"
                                            android:elevation="@dimen/dimension_0"
                                            app:cardElevation="@dimen/dimension_0">
                                            <androidx.cardview.widget.CardView
                                                android:layout_width="match_parent"
                                                android:layout_height="match_parent"
                                                android:layout_marginBottom="@dimen/dimension_3"
                                                app:cardBackgroundColor="@color/app_color4"
                                                app:cardCornerRadius="@dimen/dimension_10"
                                                android:elevation="@dimen/dimension_0"
                                                app:cardElevation="@dimen/dimension_0">

                                                <androidx.cardview.widget.CardView
                                                    android:layout_width="match_parent"
                                                    android:layout_height="match_parent"
                                                    android:layout_marginBottom="@dimen/dimension_1"
                                                    app:cardBackgroundColor="@color/transparent"
                                                    app:cardCornerRadius="@dimen/dimension_10"
                                                    android:elevation="@dimen/dimension_0"
                                                    app:cardElevation="@dimen/dimension_0">
                                            <TextView
                                                android:id="@+id/txtCancle"
                                                style="@style/single_marquee"
                                                android:layout_width="match_parent"
                                                android:layout_height="match_parent"
                                                android:text="@string/cancel"
                                                android:fontFamily="@font/jockey_one_regular"
                                                android:gravity="center"
                                                android:background="@drawable/bg_linear_color"
                                                app:layout_constraintBottom_toBottomOf="parent"
                                                app:layout_constraintTop_toTopOf="parent"
                                                android:textColor="@color/app_color"
                                                android:textSize="@dimen/text_size_20"/>
                                            </androidx.cardview.widget.CardView>
                                            </androidx.cardview.widget.CardView>
                                            </androidx.cardview.widget.CardView>
                                    </com.google.android.material.card.MaterialCardView>


                                    <com.google.android.material.card.MaterialCardView
                                        android:id="@+id/btnSave"
                                        android:layout_width="@dimen/dimension_0"
                                        android:layout_height="@dimen/dimension_0"
                                        app:layout_constraintTop_toTopOf="parent"
                                        app:layout_constraintBottom_toBottomOf="parent"
                                        app:cardCornerRadius="@dimen/dimension_10"
                                        app:cardBackgroundColor="@color/app_color2"
                                        app:strokeColor="@color/black"
                                        app:strokeWidth="@dimen/dimension_0"
                                        app:layout_constraintDimensionRatio="1.54:0.44"
                                        app:layout_constraintEnd_toEndOf="parent"
                                        app:layout_constraintStart_toEndOf="@+id/view4">
                                        <androidx.cardview.widget.CardView
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent"
                                            android:layout_marginBottom="@dimen/dimension_1"
                                            app:cardBackgroundColor="@color/app_color3"
                                            app:cardCornerRadius="@dimen/dimension_10"
                                            android:elevation="@dimen/dimension_0"
                                            app:cardElevation="@dimen/dimension_0">
                                        <androidx.cardview.widget.CardView
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent"
                                            android:layout_marginBottom="@dimen/dimension_3"
                                            app:cardBackgroundColor="@color/app_color4"
                                            app:cardCornerRadius="@dimen/dimension_10"
                                            android:elevation="@dimen/dimension_0"
                                            app:cardElevation="@dimen/dimension_0">

                                        <androidx.cardview.widget.CardView
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent"
                                            android:layout_marginBottom="@dimen/dimension_1"
                                            app:cardBackgroundColor="@color/transparent"
                                            app:cardCornerRadius="@dimen/dimension_10"
                                            android:elevation="@dimen/dimension_0"
                                            app:cardElevation="@dimen/dimension_0">
                                            <TextView
                                                android:id="@+id/txtSave"
                                                android:background="@drawable/bg_linear_color"
                                                style="@style/single_marquee"
                                                android:layout_width="match_parent"
                                                android:layout_height="match_parent"
                                                android:fontFamily="@font/jockey_one_regular"
                                                android:gravity="center"
                                                android:text="@string/done"
                                                android:textColor="@color/app_color"
                                                android:textSize="@dimen/text_size_20"
                                                app:layout_constraintBottom_toBottomOf="parent"
                                                app:layout_constraintTop_toTopOf="parent"/>
                                        </androidx.cardview.widget.CardView>
                                        </androidx.cardview.widget.CardView>
                                        </androidx.cardview.widget.CardView>
                                    </com.google.android.material.card.MaterialCardView>
                                </androidx.constraintlayout.widget.ConstraintLayout>

                                <!--                btnDone-->

                            </androidx.constraintlayout.widget.ConstraintLayout>


                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.cardview.widget.CardView>
                </androidx.cardview.widget.CardView>
            </androidx.cardview.widget.CardView>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/img_bg_splash"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:context="com.duomaker.couplelove.vatar.ui.main.successcosplay.SuccessCosplayActivity">

    <FrameLayout
        android:id="@+id/layoutActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/actionBar"
            layout="@layout/layout_actionbar4"/>
    </FrameLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimension_0"
        android:layout_marginBottom="@dimen/dimension_0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutActionBar">
        <View
            android:id="@+id/view3"
            android:layout_width="@dimen/dimension_0"
              android:layout_height="@dimen/dimension_0"
              app:layout_constraintDimensionRatio="3.6:1.22"
              app:layout_constraintStart_toStartOf="parent"
              app:layout_constraintEnd_toEndOf="parent"
              app:layout_constraintBottom_toBottomOf="parent"/>
         <View
            android:id="@+id/view4"
            android:layout_width="@dimen/dimension_0"
              android:layout_height="@dimen/dimension_0"
              app:layout_constraintDimensionRatio="3.6:0.48"
              app:layout_constraintStart_toStartOf="parent"
            android:layout_marginBottom="@dimen/dimension_12_minus"
              app:layout_constraintEnd_toEndOf="parent"
              app:layout_constraintBottom_toTopOf="@+id/view3"/>
        <androidx.cardview.widget.CardView
            android:id="@+id/btnTryAgain"
            android:layout_width="@dimen/dimension_0"
            android:layout_height="@dimen/dimension_0"
            app:layout_constraintDimensionRatio="1.56:0.48"
            app:cardBackgroundColor="@color/app_color2"
            app:layout_constraintTop_toTopOf="@+id/view4"
            app:layout_constraintBottom_toBottomOf="@+id/view4"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:cardCornerRadius="@dimen/dimension_10"
            android:elevation="@dimen/dimension_0"
            app:cardElevation="@dimen/dimension_0">
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="@dimen/dimension_1"
                app:cardBackgroundColor="@color/app_color3"
                app:cardCornerRadius="@dimen/dimension_10"
                android:elevation="@dimen/dimension_0"
                app:cardElevation="@dimen/dimension_0">
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="@dimen/dimension_3"
                    app:cardBackgroundColor="@color/app_color4"
                    app:cardCornerRadius="@dimen/dimension_10"
                    android:elevation="@dimen/dimension_0"
                    app:cardElevation="@dimen/dimension_0">

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginBottom="@dimen/dimension_1"
                        app:cardBackgroundColor="@color/transparent"
                        app:cardCornerRadius="@dimen/dimension_10"
                        android:elevation="@dimen/dimension_0"
                        app:cardElevation="@dimen/dimension_0">


                        <TextView
                            android:id="@+id/txtTryAgain"
                            android:background="@drawable/bg_linear_color"
                            style="@style/single_marquee"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:fontFamily="@font/jockey_one_regular"
                            android:gravity="center"
                            android:text="@string/try_again"
                            android:textColor="@color/app_color"
                            android:textSize="@dimen/text_size_20"/>
                    </androidx.cardview.widget.CardView>
                </androidx.cardview.widget.CardView>
            </androidx.cardview.widget.CardView>
        </androidx.cardview.widget.CardView>
        <TextView
            android:id="@+id/txtSuccessCosplay"
            android:layout_width="match_parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="@dimen/dimension_20"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dimension_30"
            android:textSize="@dimen/text_size_16"
            android:textColor="@color/app_color6"
            android:fontFamily="@font/jockey_one_regular"
            android:text="@string/you_ve_finished_this_cosplay_challenge"
            android:gravity="center"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constrainStar"
            android:layout_width="@dimen/dimension_0"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dimension_12"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_marginHorizontal="@dimen/dimension_30"
            android:orientation="vertical"
           app:layout_constraintTop_toBottomOf="@+id/txtSuccessCosplay"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <View
                android:layout_width="@dimen/dimension_0"
                android:layout_height="@dimen/dimension_0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:id="@+id/view23"
                app:layout_constraintDimensionRatio="3:0.32"/>
            <ImageView
                android:id="@+id/imgStar2"
                app:layout_constraintHorizontal_bias="0"
                android:layout_width="@dimen/dimension_0"
                android:layout_height="@dimen/dimension_0"
                android:adjustViewBounds="true"
                android:elevation="@dimen/dimension_10"
                android:src="@drawable/ic_star"
                app:layout_constraintBottom_toBottomOf="@+id/view23"
                app:layout_constraintDimensionRatio="1"
                app:layout_constraintEnd_toEndOf="@+id/view23"
                app:layout_constraintStart_toStartOf="@+id/view23"
                app:layout_constraintTop_toTopOf="@+id/view23"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layoutProgressHorizontal"
                android:layout_width="@dimen/dimension_0"
                android:layout_height="@dimen/dimension_0"
                android:elevation="@dimen/dimension_8"
                app:layout_constraintStart_toStartOf="@+id/view23"
                app:layout_constraintTop_toTopOf="@+id/view23"
                app:layout_constraintDimensionRatio="3:0.22"
                app:layout_constraintBottom_toBottomOf="@+id/view23"
                app:layout_constraintEnd_toEndOf="@+id/view23">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/progressTrack2"
                    android:layout_width="@dimen/dimension_0"
                    android:layout_height="@dimen/dimension_0"
                    android:adjustViewBounds="true"
                    android:elevation="@dimen/dimension_0"
                    app:cardBackgroundColor="@color/transparent"
                    android:scaleType="fitXY"
                    app:cardCornerRadius="@dimen/dimension_20"
                    app:strokeWidth="@dimen/dimension_0"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_progress_linear"/>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/progressTrackHorizontal"
                    android:layout_width="@dimen/dimension_0"
                    android:layout_height="@dimen/dimension_0"
                    android:adjustViewBounds="true"
                    android:layout_margin="@dimen/dimension_2"
                    android:elevation="@dimen/dimension_0"
                    app:cardBackgroundColor="@color/gray5"
                    app:cardCornerRadius="@dimen/dimension_20"
                    app:strokeColor="@color/app_color6"
                    app:strokeWidth="@dimen/dimension_2"

                    app:layout_constraintBottom_toBottomOf="@+id/progressTrack2"
                    app:layout_constraintEnd_toEndOf="@+id/progressTrack2"
                    app:layout_constraintStart_toStartOf="@+id/progressTrack2"
                    app:layout_constraintTop_toTopOf="@+id/progressTrack2"/>
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="@dimen/dimension_0"
                    android:layout_height="@dimen/dimension_0"
                    app:strokeWidth="@dimen/dimension_0"
                    app:layout_constraintStart_toStartOf="@+id/progressTrackHorizontal"
                    app:layout_constraintEnd_toEndOf="@+id/progressTrackHorizontal"
                    app:layout_constraintTop_toTopOf="@+id/progressTrackHorizontal"
                    app:layout_constraintBottom_toBottomOf="@+id/progressTrackHorizontal"
                    app:cardCornerRadius="@dimen/dimension_20"
                    android:layout_margin="@dimen/dimension_2"
                    app:cardBackgroundColor="@color/transparent">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:id="@+id/imgStarHorizontalAnchor"
                            app:layout_constraintHorizontal_bias="0"
                            android:layout_width="@dimen/dimension_0"
                            android:layout_height="@dimen/dimension_0"
                            android:adjustViewBounds="true"
                            android:elevation="@dimen/dimension_10"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintDimensionRatio="1"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <View
                            android:layout_width="@dimen/dimension_0"
                            android:layout_height="match_parent"
                            app:layout_constraintDimensionRatio="0.9:1.8"
                            android:id="@+id/viewTopHorizontal"
                            app:layout_constraintEnd_toEndOf="@+id/imgStarHorizontalAnchor"/>
                        <View
                            android:background="@color/app_color2"
                            android:id="@+id/viewProgressHorizontal"
                            android:layout_width="@dimen/dimension_0"
                            android:layout_height="@dimen/dimension_0"
                            app:layout_constraintEnd_toStartOf="@+id/viewTopHorizontal"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>

                </com.google.android.material.card.MaterialCardView>


            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.duomaker.couplelove.vatar.core.extention.OuterStrokeShadownTextView
                android:id="@+id/tvMatchPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:fontFamily="@font/jockey_one_regular"
                android:gravity="center"
                android:text="0%"
                android:textColor="@color/app_color6"
                android:textSize="@dimen/text_size_24"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/view23"
                app:outerStrokeColor="@color/white"
                app:outerStrokeWidth="@dimen/dimension_2"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="@dimen/dimension_0"
            android:layout_height="@dimen/dimension_0"
            android:id="@+id/material"
            app:layout_constraintDimensionRatio="1:1"
            android:layout_margin="@dimen/dimension_16"
            app:cardCornerRadius="@dimen/dimension_10"
            app:strokeColor="@color/black"
            app:cardBackgroundColor="@color/app_color2"
            app:strokeWidth="@dimen/dimension_0"
            app:layout_constraintBottom_toTopOf="@+id/btnTryAgain"
            app:layout_constraintTop_toBottomOf="@+id/constrainStar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintVertical_bias="0">
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="@dimen/dimension_3"
                app:cardBackgroundColor="@color/app_color3"
                app:cardCornerRadius="@dimen/dimension_10"
                app:strokeWidth="@dimen/dimension_0">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="@dimen/dimension_6"
                    app:cardBackgroundColor="@color/app_color4"
                    app:cardCornerRadius="@dimen/dimension_10"
                    app:strokeWidth="@dimen/dimension_0">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginBottom="@dimen/dimension_3"
                        app:cardBackgroundColor="@color/transparent"
                        app:cardCornerRadius="@dimen/dimension_10"
                        app:strokeWidth="@dimen/dimension_0">
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_linear_color">
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                app:strokeWidth="@dimen/dimension_0"
                                android:layout_margin="@dimen/dimension_6"
                                app:cardCornerRadius="@dimen/dimension_7"
                                app:cardBackgroundColor="@color/app_color7">

                                <ImageView
                                    android:id="@+id/imvImage"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:src="@drawable/img_permission"/>
                                <ImageView
                                    android:id="@+id/imageGif"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="fitCenter"
                                    android:visibility="gone"/>
                                <androidx.constraintlayout.widget.ConstraintLayout
                                    android:id="@+id/contrainFirst"
                                    android:visibility="gone"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="#666666">
                                    <View
                                        android:id="@+id/view1"
                                        android:layout_width="@dimen/dimension_0"
                                        android:layout_height="@dimen/dimension_0"
                                        app:layout_constraintDimensionRatio="3.28:1.36"
                                        app:layout_constraintTop_toTopOf="parent"
                                        app:layout_constraintStart_toStartOf="parent"
                                        app:layout_constraintEnd_toEndOf="parent"/>
                                    <View
                                        android:id="@+id/view2"
                                        android:layout_width="@dimen/dimension_0"
                                        android:layout_height="@dimen/dimension_0"
                                        app:layout_constraintDimensionRatio="3.28:0.64"
                                        app:layout_constraintTop_toTopOf="parent"
                                        app:layout_constraintStart_toStartOf="parent"
                                        app:layout_constraintEnd_toEndOf="parent"/>
                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="0dp"
                                        app:layout_constraintTop_toBottomOf="@+id/view2"
                                        app:layout_constraintBottom_toTopOf="@+id/imgFirst"
                                        app:layout_constraintStart_toStartOf="parent"
                                        app:layout_constraintEnd_toEndOf="parent"
                                        android:textSize="@dimen/text_size_16"
                                        android:textColor="@color/white"
                                        android:gravity="center"
                                        android:fontFamily="@font/schoolbell_regular"
                                        android:text="@string/click_the_random"/>

                                    <ImageView
                                        android:layout_width="@dimen/dimension_0"
                                        android:layout_height="@dimen/dimension_0"
                                        android:id="@+id/imgFirst"
                                        app:layout_constraintDimensionRatio="0.8:1.28"
                                        android:src="@drawable/img_first"
                                        app:layout_constraintStart_toStartOf="parent"
                                        app:layout_constraintEnd_toEndOf="parent"
                                        app:layout_constraintBottom_toBottomOf="parent"
                                        app:layout_constraintTop_toBottomOf="@+id/view1"/>

                                </androidx.constraintlayout.widget.ConstraintLayout>

                            </com.google.android.material.card.MaterialCardView>
                        </FrameLayout>
                    </com.google.android.material.card.MaterialCardView>
                </com.google.android.material.card.MaterialCardView>
            </com.google.android.material.card.MaterialCardView>
        </com.google.android.material.card.MaterialCardView>


    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>

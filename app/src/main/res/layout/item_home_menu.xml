<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dimension_4"
        android:layout_marginBottom="@dimen/dimension_8"
        xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimension_0"
            app:layout_constraintDimensionRatio="1"
            app:strokeWidth="@dimen/dimension_1"
            app:strokeColor="@color/white"
            app:cardBackgroundColor="@color/transparent"
            app:cardCornerRadius="@dimen/dimension_25">

        <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/menuContainer"
                android:layout_width="match_parent"
                android:background="@drawable/img_home1"
                android:layout_height="match_parent"
>
            <com.anime.oc.characters.avatar.core.extention.OuterStrokeTextView2
                    android:id="@+id/tvTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pony_maker"
                    android:fontFamily="@font/chela_one_regular"
                    android:textSize="@dimen/text_size_16"
                    app:layout_constraintBottom_toTopOf="@+id/view"
                    android:textColor="@color/white"
                    app:outerStrokeWidth="@dimen/dimension_1"
                    app:outerStrokeColor="@color/black1"
                    android:layout_gravity="center"
                    android:gravity="center"/>
            <View
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dimension_0"
                    app:layout_constraintDimensionRatio="2.8:0.08"
                    android:id="@+id/view"
            />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>


</androidx.constraintlayout.widget.ConstraintLayout>

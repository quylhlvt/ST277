<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/img_bg_splash"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:context="com.duomaker.couplelove.vatar.ui.main.success.SuccessActivity">
    <FrameLayout
        android:id="@+id/layoutActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <include
            android:id="@+id/actionBar"
            layout="@layout/layout_actionbar3"/>
    </FrameLayout>

    <FrameLayout
        android:layout_width="@dimen/dimension_0"
        android:layout_height="@dimen/dimension_0"
        android:id="@+id/material"
        android:layout_marginTop="@dimen/dimension_30"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintVertical_bias="0"
        app:layout_constraintBottom_toTopOf="@+id/view1"
        app:layout_constraintTop_toBottomOf="@+id/layoutActionBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <ImageView
            android:id="@+id/imvImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/img_permission"/>
    </FrameLayout>
    <View
        android:id="@+id/view1"
        android:layout_width="@dimen/dimension_0"
        android:layout_height="@dimen/dimension_0"
        app:layout_constraintDimensionRatio="3.28:0.7"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <TextView
        android:id="@+id/txtSuccess"
        style="@style/single_marquee"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/material"
        android:textSize="@dimen/text_size_20"
        android:textColor="@color/app_color6"
        android:gravity="center"
        android:fontFamily="@font/jockey_one_regular"
        android:text="@string/image_has_been_saved_successfully"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/llBottom"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimension_0"
        android:layout_marginHorizontal="@dimen/dimension_8"
        android:layout_marginTop="@dimen/dimension_10"
        android:orientation="horizontal"
        android:weightSum="328"
        app:layout_constraintTop_toBottomOf="@+id/txtSuccess"
        app:layout_constraintDimensionRatio="3.28:0.44">

        <androidx.cardview.widget.CardView
            android:id="@+id/btnBottomLeft"
            android:layout_width="@dimen/dimension_0"
            android:layout_height="match_parent"
            android:layout_weight="156"
            app:cardBackgroundColor="@color/app_color2"
            app:cardCornerRadius="@dimen/dimension_10"
            android:elevation="@dimen/dimension_0"
            app:cardElevation="@dimen/dimension_0"
        >

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="@dimen/dimension_1"
                app:cardBackgroundColor="@color/app_color3"
                app:cardCornerRadius="@dimen/dimension_10"
                android:elevation="@dimen/dimension_0"
                app:cardElevation="@dimen/dimension_0">
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="@dimen/dimension_3"
                    app:cardBackgroundColor="@color/app_color4"
                    app:cardCornerRadius="@dimen/dimension_10"
                    android:elevation="@dimen/dimension_0"
                    app:cardElevation="@dimen/dimension_0">

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginBottom="@dimen/dimension_1"
                        app:cardBackgroundColor="@color/transparent"
                        app:cardCornerRadius="@dimen/dimension_10"
                        android:elevation="@dimen/dimension_0"
                        app:cardElevation="@dimen/dimension_0">


                        <TextView
                            android:id="@+id/txtLeft"
                            android:background="@drawable/bg_linear_color"
                            style="@style/single_marquee"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:fontFamily="@font/jockey_one_regular"
                            android:gravity="center"
                            android:text="@string/my_creation"
                            android:textColor="@color/app_color"
                            android:textSize="@dimen/text_size_20"/>
                    </androidx.cardview.widget.CardView>
                </androidx.cardview.widget.CardView>
            </androidx.cardview.widget.CardView>
        </androidx.cardview.widget.CardView>

        <Space
            android:layout_width="@dimen/dimension_0"
            android:layout_height="match_parent"
            android:layout_weight="16"/>

        <androidx.cardview.widget.CardView
            android:id="@+id/btnBottomRight"
            android:layout_width="@dimen/dimension_0"
            android:layout_height="match_parent"
            android:layout_weight="156"
            app:cardBackgroundColor="@color/app_color2"
            app:cardCornerRadius="@dimen/dimension_10"
            android:elevation="@dimen/dimension_0"
            app:cardElevation="@dimen/dimension_0">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="@dimen/dimension_1"
                app:cardBackgroundColor="@color/app_color3"
                app:cardCornerRadius="@dimen/dimension_10"
                android:elevation="@dimen/dimension_0"
                app:cardElevation="@dimen/dimension_0">
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="@dimen/dimension_3"
                    app:cardBackgroundColor="@color/app_color4"
                    app:cardCornerRadius="@dimen/dimension_10"
                    android:elevation="@dimen/dimension_0"
                    app:cardElevation="@dimen/dimension_0">

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginBottom="@dimen/dimension_1"
                        app:cardBackgroundColor="@color/transparent"
                        app:cardCornerRadius="@dimen/dimension_10"
                        android:elevation="@dimen/dimension_0"
                        app:cardElevation="@dimen/dimension_0">


                        <TextView
                            android:id="@+id/txtRight"
                            android:background="@drawable/bg_linear_color"
                            style="@style/single_marquee"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:fontFamily="@font/jockey_one_regular"
                            android:gravity="center"
                            android:text="@string/download"
                            android:textColor="@color/app_color"
                            android:textSize="@dimen/text_size_20"/>
                    </androidx.cardview.widget.CardView>
                </androidx.cardview.widget.CardView>
            </androidx.cardview.widget.CardView>
        </androidx.cardview.widget.CardView>
    </androidx.appcompat.widget.LinearLayoutCompat>

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dimension_4"
        android:layout_marginBottom="@dimen/dimension_8"
        android:background="@color/transparent">

    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimension_0"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintTop_toTopOf="parent">


        <com.google.android.material.card.MaterialCardView
                android:layout_width="@dimen/dimension_0"
                android:layout_height="@dimen/dimension_0"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/dimension_4"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeColor="@color/app_color"
                app:strokeWidth="@dimen/dimension_0">


            <ImageView
                    android:id="@+id/imvImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_permission"/>


        </com.google.android.material.card.MaterialCardView>


        <ImageView
                android:id="@+id/btnDelete"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_width="@dimen/dimension_30"
                android:layout_height="@dimen/dimension_30"
                android:layout_margin="@dimen/dimension_8"
                android:src="@drawable/ic_delete1"/>


        <!--        btnSelect-->
        <ImageView
                android:id="@+id/btnSelect"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_width="@dimen/dimension_30"
                android:layout_height="@dimen/dimension_30"
                android:layout_margin="@dimen/dimension_8"
                android:src="@drawable/ic_not_select"
                android:visibility="gone"/>

    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>

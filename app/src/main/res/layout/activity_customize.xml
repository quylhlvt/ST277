<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/app_color2"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        tools:context="com.duomaker.couplelove.vatar.ui.main.customize.CustomizeActivity">

    <FrameLayout
            android:id="@+id/layoutActionBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent">

        <include
                android:id="@+id/actionBar"
                layout="@layout/layout_actionbar3"/>
    </FrameLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintLayout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimension_0"
            android:elevation="@dimen/dimension_16"
            android:layout_gravity="bottom"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layoutActionBar"
            app:layout_constraintVertical_bias="0.0"

            tools:layout_editor_absoluteX="-16dp">

        <com.google.android.material.card.MaterialCardView
                android:id="@+id/rlCharacter1"
                android:layout_width="@dimen/dimension_0"
                android:layout_height="@dimen/dimension_0"
                android:elevation="@dimen/dimension_2"
                app:strokeColor="@color/app_color"
                app:cardCornerRadius="@dimen/dimension_4"
                android:layout_margin="@dimen/dimension_16"
                app:cardBackgroundColor="@color/white"
                android:background="@android:color/transparent"
                app:layout_constraintBottom_toTopOf="@+id/constraintSelect"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
            <FrameLayout
                    android:id="@+id/rlCharacter"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:elevation="@dimen/dimension_0"/>
        </com.google.android.material.card.MaterialCardView>


        <View android:layout_width="match_parent" android:layout_height="@dimen/dimension_0"
              app:layout_constraintTop_toTopOf="@+id/constraintSelect"
              app:layout_constraintBottom_toBottomOf="parent"
              android:background="@color/app_color9"/>
        <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/constraintSelect"
                android:layout_width="@dimen/dimension_0"
                android:layout_height="@dimen/dimension_0"
                android:elevation="@dimen/dimension_8"
                app:layout_constraintDimensionRatio="3.6:0.5"
                app:layout_constraintBottom_toTopOf="@+id/frame_rando_all"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">
            <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dimension_0"
                    app:layout_constraintDimensionRatio="3.6:0.08"
                    android:id="@+id/view17"
                    app:layout_constraintTop_toTopOf="parent"/>
            <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dimension_0"
                    app:layout_constraintDimensionRatio="3.6:0.08"
                    android:id="@+id/view18"
                    app:layout_constraintBottom_toBottomOf="parent"/>


            <ImageView
                    android:id="@+id/imgRandom"
                    android:src="@drawable/ic_random"
                    android:layout_width="@dimen/dimension_0"
                    android:layout_height="@dimen/dimension_0"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_constraintBottom_toTopOf="@+id/view18"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginEnd="@dimen/dimension_16"
                    app:layout_constraintTop_toBottomOf="@+id/view17"
                    app:layout_constraintVertical_bias="1.0"/>
            <ImageView
                    android:id="@+id/imgReset"
                    android:src="@drawable/ic_reset_all_custom"
                    android:layout_width="@dimen/dimension_0"
                    android:layout_height="@dimen/dimension_0"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_constraintBottom_toTopOf="@+id/view18"
                    app:layout_constraintDimensionRatio="1:1"
                    android:layout_marginStart="@dimen/dimension_16"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/view17"/>
            <ImageView
                    android:id="@+id/imgFlip"
                    android:src="@drawable/ic_flip_all_custom"
                    android:layout_width="@dimen/dimension_0"
                    android:layout_height="@dimen/dimension_0"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginStart="@dimen/dimension_8"
                    app:layout_constraintBottom_toTopOf="@+id/view18"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintStart_toEndOf="@+id/imgReset"
                    app:layout_constraintTop_toBottomOf="@+id/view17"/>
            <ImageView
                    android:id="@+id/imgScale"
                    android:src="@drawable/ic_scale_cus"
                    android:layout_width="@dimen/dimension_0"
                    android:layout_height="@dimen/dimension_0"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginStart="@dimen/dimension_8"
                    app:layout_constraintBottom_toTopOf="@+id/view18"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintStart_toEndOf="@+id/imgFlip"
                    app:layout_constraintTop_toBottomOf="@+id/view17"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/frame_rando_all"
                android:layout_width="@dimen/dimension_0"
                android:layout_height="@dimen/dimension_0"
                app:layout_constraintDimensionRatio="3.6:0.32"
                app:layout_constraintBottom_toTopOf="@+id/frameLayer"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

            <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dimension_0"
                    app:layout_constraintDimensionRatio="3.6:0.08"
                    android:id="@+id/view5"
                    app:layout_constraintBottom_toBottomOf="parent"/>


            <!--            &lt;!&ndash; Icon random &ndash;&gt;-->
            <!--            <ImageView-->
            <!--                    android:id="@+id/imgChangColor"-->
            <!--                    android:src="@drawable/img_change_color"-->

            <!--                    android:layout_width="@dimen/dimension_0"-->
            <!--                    android:layout_height="@dimen/dimension_0"-->
            <!--                    android:clickable="true"-->
            <!--                    android:focusable="true"-->
            <!--                    app:layout_constraintBottom_toTopOf="@+id/view5"-->
            <!--                    app:layout_constraintDimensionRatio="1:1"-->
            <!--                    app:layout_constraintStart_toEndOf="@+id/view6"-->
            <!--                    app:layout_constraintTop_toBottomOf="@+id/view4"-->
            <!--                    app:layout_constraintVertical_bias="1.0"/>-->


            <androidx.constraintlayout.widget.ConstraintLayout
                    android:elevation="@dimen/dimension_1"
                    android:id="@+id/llColor"
                    android:layout_width="@dimen/dimension_0"
                    android:layout_marginHorizontal="@dimen/dimension_16"
                    android:layout_height="@dimen/dimension_0"
                    app:layout_constraintBottom_toTopOf="@+id/view5"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent">


                <FrameLayout
                        android:id="@+id/cardColor"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"

                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                    <RelativeLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="@dimen/dimension_0">

                        <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rcvColor"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:clipToPadding="false"
                                android:orientation="horizontal"
                                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                                tools:itemCount="5"
                                tools:listitem="@layout/item_color"/>
                    </RelativeLayout>


                </FrameLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/frameLayer"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimension_0"
                app:layout_constraintBottom_toTopOf="@+id/constraintNav"
                app:layout_constraintHeight_percent="0.25">

            <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rcvPart"
                    android:layout_width="0dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginHorizontal="@dimen/dimension_20"
                    android:layout_height="match_parent"
                    android:elevation="@dimen/dimension_1"
                    app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                    app:spanCount="5"
                    tools:itemCount="40"
                    tools:listitem="@layout/item_layer"/>


        </androidx.constraintlayout.widget.ConstraintLayout>
        <FrameLayout
                android:id="@+id/frameScale"
                android:layout_width="@dimen/dimension_0"
                android:layout_height="@dimen/dimension_0"
                android:background="@color/app_color9"
                android:clickable="true"
                android:elevation="@dimen/dimension_10"
                android:focusable="true"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/constraintSelect">

            <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="@dimen/dimension_24"
                    android:layout_marginVertical="@dimen/dimension_3">

                <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/constraintLayout4"
                        android:layout_width="@dimen/dimension_0"
                        android:layout_height="@dimen/dimension_0"
                        android:layout_marginTop="@dimen/dimension_24"
                        app:layout_constraintDimensionRatio="3.12:0.4"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                    <com.google.android.material.card.MaterialCardView
                            android:id="@+id/btnExitScale"
                            android:layout_width="@dimen/dimension_0"
                            android:layout_height="@dimen/dimension_0"
                            app:cardBackgroundColor="@color/transparent"
                            app:cardCornerRadius="@dimen/dimension_20"
                            app:layout_constraintDimensionRatio="0.88:0.4"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:strokeColor="@color/app_color10"
                            app:strokeWidth="@dimen/dimension_1">
                        <View
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_card_custom_scale_reset"/>
                        <com.google.android.material.card.MaterialCardView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_margin="@dimen/dimension_4"
                                app:cardBackgroundColor="@color/app_color15"
                                app:cardCornerRadius="@dimen/dimension_15"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:strokeColor="@color/app_color14"
                                app:strokeWidth="@dimen/dimension_1">
                            <androidx.cardview.widget.CardView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    app:cardBackgroundColor="@color/app_color16"
                                    android:layout_marginBottom="@dimen/dimension_4"
                                    app:cardCornerRadius="@dimen/dimension_15">
                                <androidx.appcompat.widget.AppCompatTextView
                                        android:id="@+id/txtExit"
                                        style="@style/single_marquee"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:fontFamily="@font/schoolbell_regular"
                                        android:gravity="center"
                                        android:text="@string/exit"
                                        android:textColor="@color/white"
                                        android:textSize="@dimen/text_size_16"/>
                            </androidx.cardview.widget.CardView>
                        </com.google.android.material.card.MaterialCardView>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                            android:id="@+id/btnResetScale"
                            app:layout_constraintHorizontal_bias="0"
                            android:layout_width="@dimen/dimension_0"
                            android:layout_height="@dimen/dimension_0"
                            android:layout_marginStart="@dimen/dimension_8"
                            app:cardBackgroundColor="@color/transparent"
                            app:cardCornerRadius="@dimen/dimension_20"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintDimensionRatio="0.88:0.4"
                            app:layout_constraintEnd_toStartOf="@+id/ratioLeft"
                            app:layout_constraintStart_toEndOf="@+id/btnExitScale"
                            app:layout_constraintTop_toTopOf="parent"
                            app:strokeColor="@color/app_color10"
                            app:strokeWidth="@dimen/dimension_1">

                        <View
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_card_custom_scale_reset"/>

                        <com.google.android.material.card.MaterialCardView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_margin="@dimen/dimension_4"
                                app:cardBackgroundColor="@color/app_color12"
                                app:cardCornerRadius="@dimen/dimension_15"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:strokeColor="@color/app_color11"
                                app:strokeWidth="@dimen/dimension_1">

                            <androidx.cardview.widget.CardView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_marginBottom="@dimen/dimension_4"
                                    app:cardBackgroundColor="@color/app_color13"
                                    app:cardCornerRadius="@dimen/dimension_15">

                                <androidx.appcompat.widget.AppCompatTextView
                                        android:id="@+id/txtReset"
                                        style="@style/single_marquee"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:fontFamily="@font/schoolbell_regular"
                                        android:gravity="center"
                                        android:text="@string/reset"
                                        android:textColor="@color/white"
                                        android:textSize="@dimen/text_size_16"/>
                            </androidx.cardview.widget.CardView>
                        </com.google.android.material.card.MaterialCardView>
                    </com.google.android.material.card.MaterialCardView>
                    <ImageView
                            android:id="@+id/ratioRight"
                            android:layout_width="0dp"
                            app:layout_constraintDimensionRatio="1"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            android:layout_height="@dimen/dimension_0"
                            app:layout_constraintEnd_toEndOf="parent"
                            android:src="@drawable/ratio_right"/>


                    <ImageView
                            android:id="@+id/ratioLeft"
                            android:layout_width="@dimen/dimension_0"
                            android:layout_height="@dimen/dimension_0"
                            android:layout_marginEnd="@dimen/dimension_8"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintDimensionRatio="1"
                            app:layout_constraintEnd_toStartOf="@+id/ratioRight"
                            app:layout_constraintBottom_toBottomOf="parent"
                            android:src="@drawable/ratio_left"/>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <com.duomaker.couplelove.vatar.ui.main.customize.vertical.VerticalSizeSlider
                        android:id="@+id/sliderSize"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dimension_0"
                        android:layout_marginTop="@dimen/dimension_16"
                        app:layout_constraintDimensionRatio="3.08:0.4"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/constraintLayout4"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="@dimen/dimension_0"
                        android:layout_height="@dimen/dimension_0"
                        android:layout_marginVertical="@dimen/dimension_16"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintDimensionRatio="1.84:1.2"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/sliderSize">

                    <ImageView
                            android:id="@+id/transitionLeft"
                            android:layout_width="@dimen/dimension_0"
                            android:layout_height="@dimen/dimension_0"
                            android:src="@drawable/transition_left"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintDimensionRatio="1"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/transitionBottom"
                            app:layout_constraintTop_toTopOf="@+id/transitionBottom"/>

                    <ImageView
                            android:id="@+id/transitionRight"
                            android:layout_width="@dimen/dimension_0"
                            android:layout_height="@dimen/dimension_0"
                            android:src="@drawable/transition_right"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintDimensionRatio="1"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="@+id/transitionBottom"/>
                    <ImageView
                            android:id="@+id/transitionTop"
                            android:layout_width="@dimen/dimension_0"
                            android:layout_height="@dimen/dimension_0"
                            android:src="@drawable/transition_top"
                            android:layout_marginBottom="@dimen/dimension_8"
                            app:layout_constraintDimensionRatio="1"
                            app:layout_constraintEnd_toEndOf="@+id/transitionBottom"
                            app:layout_constraintStart_toStartOf="@+id/transitionBottom"

                            app:layout_constraintBottom_toTopOf="@+id/transitionBottom"
                            app:layout_constraintTop_toTopOf="parent"/>

                    <ImageView
                            android:id="@+id/transitionBottom"
                            android:layout_width="@dimen/dimension_0"
                            android:layout_height="@dimen/dimension_0"
                            app:layout_constraintDimensionRatio="1"
                            android:src="@drawable/transition_bottom"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/transitionTop"
                            app:layout_constraintEnd_toStartOf="@+id/transitionRight"
                            app:layout_constraintStart_toEndOf="@+id/transitionLeft"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </FrameLayout>


        <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="@dimen/dimension_0"
                android:id="@+id/constraintNav"
                android:layout_height="@dimen/dimension_56"
                android:background="@color/app_color4"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

            <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rcvNav"
                    android:layout_width="@dimen/dimension_0"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:elevation="@dimen/dimension_1"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginStart="@dimen/dimension_16"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"

                    tools:listitem="@layout/item_bottom_custom"/>

        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

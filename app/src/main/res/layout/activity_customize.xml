<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/app_color2"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        tools:context="com.anime.oc.characters.avatar.ui.main.customize.CustomizeActivity">

    <FrameLayout
            android:id="@+id/layoutActionBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent">

        <include
                android:id="@+id/actionBar"
                layout="@layout/layout_actionbar3"/>
    </FrameLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintLayout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimension_0"
            android:elevation="@dimen/dimension_16"
            android:layout_gravity="bottom"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layoutActionBar"
            app:layout_constraintVertical_bias="0.0"

            tools:layout_editor_absoluteX="-16dp">

        <com.google.android.material.card.MaterialCardView
                android:id="@+id/rlCharacter1"
                android:layout_width="@dimen/dimension_0"
                android:layout_height="@dimen/dimension_0"
                android:elevation="@dimen/dimension_2"
                app:strokeColor="@color/app_color"
                app:cardCornerRadius="@dimen/dimension_4"
                android:layout_margin="@dimen/dimension_16"
                app:cardBackgroundColor="@color/white"
                android:background="@android:color/transparent"
                app:layout_constraintBottom_toTopOf="@+id/constraintSelect"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
            <FrameLayout
                    android:id="@+id/rlCharacter"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:elevation="@dimen/dimension_0"/>
        </com.google.android.material.card.MaterialCardView>


        <View android:layout_width="match_parent" android:layout_height="@dimen/dimension_0"
              app:layout_constraintTop_toTopOf="@+id/constraintSelect"
              app:layout_constraintBottom_toBottomOf="parent"
              android:background="@color/app_color9"/>
        <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/constraintSelect"
                android:layout_width="@dimen/dimension_0"
                android:layout_height="@dimen/dimension_0"
                android:elevation="@dimen/dimension_18"
                app:layout_constraintDimensionRatio="3.6:0.5"
                app:layout_constraintBottom_toTopOf="@+id/frame_rando_all"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">
            <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dimension_0"
                    app:layout_constraintDimensionRatio="3.6:0.08"
                    android:id="@+id/view17"
                    app:layout_constraintTop_toTopOf="parent"/>
            <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dimension_0"
                    app:layout_constraintDimensionRatio="3.6:0.08"
                    android:id="@+id/view18"
                    app:layout_constraintBottom_toBottomOf="parent"/>


            <ImageView
                    android:id="@+id/imgRandom"
                    android:src="@drawable/ic_random"
                    android:layout_width="@dimen/dimension_0"
                    android:layout_height="@dimen/dimension_0"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_constraintBottom_toTopOf="@+id/view18"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginEnd="@dimen/dimension_16"
                    app:layout_constraintTop_toBottomOf="@+id/view17"
                    app:layout_constraintVertical_bias="1.0"/>
            <ImageView
                    android:id="@+id/imgReset"
                    android:src="@drawable/ic_reset_all_custom"
                    android:layout_width="@dimen/dimension_0"
                    android:layout_height="@dimen/dimension_0"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_constraintBottom_toTopOf="@+id/view18"
                    app:layout_constraintDimensionRatio="1:1"
                    android:layout_marginStart="@dimen/dimension_16"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/view17"/>
            <ImageView
                    android:id="@+id/imgFlip"
                    android:src="@drawable/ic_flip_all_custom"
                    android:layout_width="@dimen/dimension_0"
                    android:layout_height="@dimen/dimension_0"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginStart="@dimen/dimension_8"
                    app:layout_constraintBottom_toTopOf="@+id/view18"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintStart_toEndOf="@+id/imgReset"
                    app:layout_constraintTop_toBottomOf="@+id/view17"/>
            <ImageView
                    android:id="@+id/imgScale"
                    android:src="@drawable/ic_scale_cus"
                    android:layout_width="@dimen/dimension_0"
                    android:layout_height="@dimen/dimension_0"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginStart="@dimen/dimension_8"
                    app:layout_constraintBottom_toTopOf="@+id/view18"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintStart_toEndOf="@+id/imgFlip"
                    app:layout_constraintTop_toBottomOf="@+id/view17"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/frame_rando_all"
                android:layout_width="@dimen/dimension_0"
                android:layout_height="@dimen/dimension_0"
                app:layout_constraintDimensionRatio="3.6:0.32"
                app:layout_constraintBottom_toTopOf="@+id/frameLayer"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

            <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dimension_0"
                    app:layout_constraintDimensionRatio="3.6:0.08"
                    android:id="@+id/view5"
                    app:layout_constraintBottom_toBottomOf="parent"/>




<!--            &lt;!&ndash; Icon random &ndash;&gt;-->
<!--            <ImageView-->
<!--                    android:id="@+id/imgChangColor"-->
<!--                    android:src="@drawable/img_change_color"-->

<!--                    android:layout_width="@dimen/dimension_0"-->
<!--                    android:layout_height="@dimen/dimension_0"-->
<!--                    android:clickable="true"-->
<!--                    android:focusable="true"-->
<!--                    app:layout_constraintBottom_toTopOf="@+id/view5"-->
<!--                    app:layout_constraintDimensionRatio="1:1"-->
<!--                    app:layout_constraintStart_toEndOf="@+id/view6"-->
<!--                    app:layout_constraintTop_toBottomOf="@+id/view4"-->
<!--                    app:layout_constraintVertical_bias="1.0"/>-->




            <androidx.constraintlayout.widget.ConstraintLayout
                    android:elevation="@dimen/dimension_1"
                    android:id="@+id/llColor"
                    android:layout_width="@dimen/dimension_0"
                    android:layout_marginHorizontal="@dimen/dimension_16"
                    android:layout_height="@dimen/dimension_0"
                    app:layout_constraintBottom_toTopOf="@+id/view5"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent">



                <FrameLayout
                        android:id="@+id/cardColor"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"

                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                    <RelativeLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="@dimen/dimension_0">

                        <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rcvColor"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:clipToPadding="false"
                                android:orientation="horizontal"
                                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                                tools:itemCount="5"
                                tools:listitem="@layout/item_color"/>
                    </RelativeLayout>


                </FrameLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/frameLayer"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimension_0"
                app:layout_constraintBottom_toTopOf="@+id/constraintNav"
                app:layout_constraintHeight_percent="0.25">

            <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rcvPart"
                    android:layout_width="0dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginHorizontal="@dimen/dimension_20"
                    android:layout_height="match_parent"
                    android:elevation="@dimen/dimension_1"
                    app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                    app:spanCount="5"
                    tools:itemCount="40"
                    tools:listitem="@layout/item_layer"/>


        </androidx.constraintlayout.widget.ConstraintLayout>
        <FrameLayout
                android:id="@+id/frameScale"
                android:layout_width="@dimen/dimension_0"
                android:layout_height="@dimen/dimension_0"
                android:background="@color/app_color5"
                android:clickable="true"
                android:elevation="@dimen/dimension_5"
                android:focusable="true"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/frameLayer">

            <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="@dimen/dimension_16"
                    android:layout_marginVertical="@dimen/dimension_3">

                <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/constraintLayout4"
                        android:layout_width="@dimen/dimension_0"
                        android:layout_height="@dimen/dimension_0"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintDimensionRatio="0.65:2.52"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                    <com.google.android.material.card.MaterialCardView
                            android:id="@+id/btnResetScale"
                            android:layout_width="@dimen/dimension_0"
                            android:layout_height="@dimen/dimension_0"
                            app:strokeWidth="@dimen/dimension_0"
                            android:layout_marginTop="@dimen/dimension_16"
                            app:cardCornerRadius="@dimen/dimension_10"
                            android:layout_marginEnd="@dimen/dimension_3"
                            app:cardBackgroundColor="@color/app_color6"
                            app:layout_constraintDimensionRatio="0.57:0.36"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">
                        <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/txtReset"
                                style="@style/single_marquee"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:fontFamily="@font/pacifico_regular"
                                android:gravity="center"
                                android:text="@string/reset"
                                android:paddingBottom="@dimen/dimension_5"
                                android:textColor="@color/app_color"
                                android:textSize="@dimen/text_size_16"/>
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                            android:layout_width="@dimen/dimension_0"
                            android:layout_height="@dimen/dimension_0"
                            app:layout_constraintVertical_bias="0"
                            android:orientation="vertical"
                            android:weightSum="104"
                            android:layout_marginTop="@dimen/dimension_22"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintDimensionRatio="0.6:1.04"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/btnResetScale">

                        <ImageView
                                android:id="@+id/ratioRight"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/dimension_0"
                                android:layout_weight="44"
                                android:src="@drawable/ratio_right"/>

                        <Space
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/dimension_0"
                                android:layout_weight="16"/>

                        <ImageView
                                android:id="@+id/ratioLeft"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/dimension_0"
                                android:layout_weight="44"
                                android:src="@drawable/ratio_left"/>
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <View
                        android:id="@+id/view"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dimension_0"
                        app:layout_constraintDimensionRatio="3.6:0.36"
                        app:layout_constraintTop_toTopOf="parent"
                        android:layout_marginTop="@dimen/dimension_10"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="@dimen/dimension_0"
                        android:layout_height="@dimen/dimension_0"
                        android:layout_marginHorizontal="@dimen/dimension_5"
                        android:layout_marginBottom="@dimen/dimension_16"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintDimensionRatio="1:1"
                        app:layout_constraintEnd_toStartOf="@+id/constraintLayout3"
                        app:layout_constraintStart_toEndOf="@+id/constraintLayout4"
                        app:layout_constraintTop_toBottomOf="@+id/view">

                    <ImageView
                            android:id="@+id/transitionLeft"
                            android:layout_width="@dimen/dimension_0"
                            android:layout_height="@dimen/dimension_0"
                            android:src="@drawable/transition_left"
                            app:layout_constraintBottom_toTopOf="@+id/transitionBottom"
                            app:layout_constraintDimensionRatio="0.49:0.44"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/transitionTop"/>

                    <ImageView
                            android:id="@+id/transitionRight"
                            android:layout_width="@dimen/dimension_0"
                            android:layout_height="@dimen/dimension_0"
                            android:src="@drawable/transition_right"
                            app:layout_constraintBottom_toTopOf="@+id/transitionBottom"
                            app:layout_constraintDimensionRatio="0.49:0.44"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/transitionTop"/>

                    <ImageView
                            android:id="@+id/transitionTop"
                            android:layout_width="@dimen/dimension_0"
                            android:layout_height="@dimen/dimension_0"
                            android:src="@drawable/transition_top"
                            app:layout_constraintDimensionRatio="0.44:0.49"
                            app:layout_constraintEnd_toStartOf="@+id/transitionRight"
                            app:layout_constraintStart_toEndOf="@+id/transitionLeft"
                            app:layout_constraintTop_toTopOf="parent"/>

                    <ImageView
                            android:id="@+id/transitionBottom"
                            android:layout_width="@dimen/dimension_0"
                            android:layout_height="@dimen/dimension_0"
                            android:src="@drawable/transition_bottom"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintDimensionRatio="0.44:0.49"
                            app:layout_constraintEnd_toStartOf="@+id/transitionRight"
                            app:layout_constraintStart_toEndOf="@+id/transitionLeft"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/constraintLayout3"
                        android:layout_width="@dimen/dimension_0"
                        android:layout_height="@dimen/dimension_0"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintDimensionRatio="0.65:2.52"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                    <View
                            android:id="@+id/btnResetScale2"
                            android:layout_width="@dimen/dimension_0"
                            android:layout_height="@dimen/dimension_0"
                            app:strokeWidth="@dimen/dimension_0"
                            android:layout_marginTop="@dimen/dimension_16"
                            app:cardCornerRadius="@dimen/dimension_10"
                            android:layout_marginEnd="@dimen/dimension_3"
                            app:cardBackgroundColor="@color/app_color6"
                            app:layout_constraintDimensionRatio="0.57:0.36"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                    <LinearLayout
                            android:layout_width="@dimen/dimension_0"
                            android:layout_height="@dimen/dimension_0"
                            app:layout_constraintVertical_bias="0"
                            android:orientation="vertical"
                            android:id="@+id/linear"
                            android:weightSum="104"
                            android:layout_marginTop="@dimen/dimension_22"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintDimensionRatio="0.6:1.04"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/btnResetScale2">

                        <ImageView
                                android:id="@+id/scalePlus"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/dimension_0"
                                android:layout_weight="44"
                                android:src="@drawable/scale_plus"/>

                        <Space
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/dimension_0"
                                android:layout_weight="16"/>

                        <ImageView
                                android:id="@+id/scaleMinus"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/dimension_0"
                                android:layout_weight="44"
                                android:src="@drawable/scale_minus"/>
                    </LinearLayout>
                    <TextView
                            android:id="@+id/txtSize"
                            android:layout_width="@dimen/dimension_0"
                            android:layout_height="@dimen/dimension_0"
                            app:strokeWidth="@dimen/dimension_0"
                            android:text="@string/size_slider"
                            android:gravity="center"
                            android:textColor="@color/app_color"
                            android:fontFamily="@font/pacifico_regular"
                            android:textSize="@dimen/text_size_16"
                            android:layout_marginEnd="@dimen/dimension_3"
                            app:cardBackgroundColor="@color/app_color6"
                            app:layout_constraintDimensionRatio="0.57:0.36"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/linear"
                            app:layout_constraintBottom_toBottomOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

        </FrameLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="@dimen/dimension_0"
                android:id="@+id/constraintNav"
                android:layout_height="@dimen/dimension_56"
                android:background="@color/app_color4"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

            <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rcvNav"
                    android:layout_width="@dimen/dimension_0"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:elevation="@dimen/dimension_1"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginStart="@dimen/dimension_16"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"

                    tools:listitem="@layout/item_bottom_custom"/>

        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:app="http://schemas.android.com/apk/res-auto"
              xmlns:tools="http://schemas.android.com/tools"
              android:id="@+id/lnlBackground"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:orientation="vertical"
              android:weightSum="272">

    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/linear"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimension_0"
            android:layout_marginHorizontal="@dimen/dimension_50"
            android:layout_weight="52"
            android:weightSum="2"
            android:elevation="@dimen/dimension_2">

        <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnBackgroundImage"
                android:layout_width="@dimen/dimension_0"
                android:layout_marginVertical="@dimen/dimension_8"
                android:layout_height="@dimen/dimension_0"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginEnd="@dimen/dimension_4"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/btnBackgroundColor"
                android:layout_gravity="center"
                app:cardBackgroundColor="@color/white"
                app:strokeWidth="@dimen/dimension_1"
                app:strokeColor="@color/black"
                app:cardCornerRadius="@dimen/dimension_100"
               >
            <androidx.cardview.widget.CardView
                    android:id="@+id/cardBackgroundImage"
                    android:layout_margin="@dimen/dimension_3"
                    android:layout_width="match_parent"
                    android:elevation="@dimen/dimension_0"
                    app:cardElevation="@dimen/dimension_0"
                    app:cardBackgroundColor="@color/app_color3"
                    android:layout_height="match_parent"
                    app:cardCornerRadius="@dimen/dimension_100">


                <TextView
                        android:id="@+id/txtBackgroundImage"
                        style="@style/single_marquee"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="@string/image"
                        android:fontFamily="@font/schoolbell_regular"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_size_20"
                        tools:ignore="NestedWeights"/>
            </androidx.cardview.widget.CardView>


        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnBackgroundColor"
                android:layout_width="@dimen/dimension_0"
                android:layout_marginStart="@dimen/dimension_4"
                android:layout_marginVertical="@dimen/dimension_8"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/btnBackgroundImage"
                android:layout_height="@dimen/dimension_0"
                android:layout_gravity="center"
                app:cardBackgroundColor="@color/white"
                app:strokeWidth="@dimen/dimension_1"
                app:strokeColor="@color/gray1"
                app:cardCornerRadius="@dimen/dimension_100"
        >
            <androidx.cardview.widget.CardView
                    android:id="@+id/cardBackgroundColor"
                    android:layout_margin="@dimen/dimension_3"
                    android:layout_width="match_parent"
                    android:elevation="@dimen/dimension_0"
                    app:cardElevation="@dimen/dimension_0"
                    app:cardBackgroundColor="@color/gray1"
                    android:layout_height="match_parent"
                    app:cardCornerRadius="@dimen/dimension_100">


            <TextView
                    android:id="@+id/txtBackgroundColor"
                    style="@style/single_marquee"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/color"
                    android:fontFamily="@font/schoolbell_regular"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_20"/>
            </androidx.cardview.widget.CardView>
        </com.google.android.material.card.MaterialCardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
            android:layout_marginTop="@dimen/dimension_4"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimension_0"
            android:paddingHorizontal="@dimen/dimension_1"
            android:layout_weight="220">
        <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/tabImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
            <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rcvBackgroundImage"
                    android:layout_width="match_parent"
                    android:layout_marginHorizontal="@dimen/dimension_20"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:layout_height="@dimen/dimension_0"
                    app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                    app:spanCount="5"
                    tools:itemCount="30"
                    tools:listitem="@layout/item_background_image"/>
        </androidx.constraintlayout.widget.ConstraintLayout>


        <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rcvBackgroundColor"
                android:layout_width="match_parent"
                android:layout_marginHorizontal="@dimen/dimension_20"
                android:layout_height="match_parent"
                android:visibility="gone"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="5"
                tools:listitem="@layout/item_background_color"/>
    </FrameLayout>

</LinearLayout>

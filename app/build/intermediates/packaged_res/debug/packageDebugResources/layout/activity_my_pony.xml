<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/img_bg_splash"
    tools:context="com.duomaker.couplelove.vatar.ui.main.myPony.MyPonyActivity">

    <!-- layoutActionBar -->
    <FrameLayout
        android:id="@+id/layoutActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/actionBar"
            layout="@layout/layout_actionbar"/>
    </FrameLayout>

    <!--    cvType-->
    <LinearLayout
        android:id="@+id/cvType"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimension_0"
        android:layout_marginTop="@dimen/dimension_10"
        android:orientation="horizontal"
        android:weightSum="360"
        app:layout_constraintDimensionRatio="3.6:0.48"
        app:layout_constraintTop_toBottomOf="@id/layoutActionBar">

        <Space
            android:layout_width="@dimen/dimension_0"
            android:layout_height="match_parent"
            android:layout_weight="24"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="312"
            android:orientation="horizontal"
            android:weightSum="312">

            <!--            btnMyAvatar-->
            <FrameLayout
                android:id="@+id/btnMyAvatar"
                android:layout_width="@dimen/dimension_0"
                android:layout_height="match_parent"
                android:layout_weight="156"
                android:background="@drawable/bg_linear_color_mycreation">

                <TextView
                    android:id="@+id/tvMyAvatar"
                    style="@style/single_marquee"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="@dimen/dimension_3"
                    android:layout_marginBottom="@dimen/dimension_3"
                    android:elevation="@dimen/dimension_3"
                    android:fontFamily="@font/jockey_one_regular"
                    android:gravity="center"
                    android:text="@string/my_avatar"
                    android:textColor="@color/app_color"
                    android:textSize="@dimen/text_size_20"
                    app:layout_constraintBottom_toBottomOf="@+id/imgMyponyFor"
                    app:layout_constraintEnd_toEndOf="@+id/imgMyponyFor"
                    app:layout_constraintStart_toStartOf="@+id/imgMyponyFor"
                    app:layout_constraintTop_toTopOf="@+id/imgMyponyFor"/>


            </FrameLayout>


            <FrameLayout
                android:id="@+id/btnMyDesign"
                android:layout_width="@dimen/dimension_0"
                android:layout_height="match_parent"
                android:layout_weight="156"
                android:background="@drawable/bg_unselect_tag_mycreation">

                <TextView
                    android:id="@+id/tvMyDesign"
                    style="@style/single_marquee"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="@dimen/dimension_3"
                    android:layout_marginBottom="@dimen/dimension_3"
                    android:elevation="@dimen/dimension_3"
                    android:fontFamily="@font/jockey_one_regular"
                    android:gravity="center"
                    android:text="@string/design"
                    android:textColor="@color/app_color"
                    android:textSize="@dimen/text_size_20"
                    app:layout_constraintBottom_toBottomOf="@+id/imgMyponyFor"
                    app:layout_constraintEnd_toEndOf="@+id/imgMyponyFor"
                    app:layout_constraintStart_toStartOf="@+id/imgMyponyFor"
                    app:layout_constraintTop_toTopOf="@+id/imgMyponyFor"/>


            </FrameLayout>

            <!--            btnMyDesign-->

        </LinearLayout>

        <Space
            android:layout_width="@dimen/dimension_0"
            android:layout_height="match_parent"
            android:layout_weight="24"/>
    </LinearLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mater"
        android:layout_width="@dimen/dimension_0"
        android:layout_height="@dimen/dimension_0"
        android:layout_marginBottom="@dimen/dimension_0"
        android:background="@color/transparent"
        android:elevation="@dimen/dimension_2"
        android:paddingHorizontal="@dimen/dimension_8"
        app:cardBackgroundColor="@color/app_color"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"

        app:layout_constraintTop_toBottomOf="@+id/cvType"
        app:strokeWidth="@dimen/dimension_0">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/noItem"
            android:layout_width="0dp"
            android:layout_height="@dimen/dimension_0"
            android:layout_gravity="center"
            android:layout_marginHorizontal="@dimen/dimension_70"
            android:gravity="center"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="2:2.2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/img_Noitem"
                android:layout_width="@dimen/dimension_0"
                android:layout_height="@dimen/dimension_0"
                android:src="@drawable/img_noitem"
                app:layout_constraintDimensionRatio="1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <TextView
                android:id="@+id/txtItem"
                style="@style/single_marquee"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimension_0"
                android:fontFamily="@font/schoolbell_regular"
                android:gravity="center"
                android:text="@string/no_item_here"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/img_Noitem"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:id="@+id/bottomview"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimension_32"
            app:layout_constraintBottom_toBottomOf="parent"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycleAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="@dimen/dimension_0"
            android:layout_marginTop="@dimen/dimension_12"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:spanCount="2"
            tools:itemCount="9"
            tools:listitem="@layout/item_my_avatar"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycleDesign"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="@dimen/dimension_0"
            android:layout_marginTop="@dimen/dimension_12"
            android:visibility="gone"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:spanCount="2"
            tools:itemCount="9"
            tools:listitem="@layout/item_my_design"/>


        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/lnlBottom"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimension_0"
            android:layout_marginHorizontal="@dimen/dimension_8"
            android:layout_marginBottom="@dimen/dimension_8"
            android:orientation="horizontal"
            android:weightSum="328"
            app:layout_constraintBottom_toTopOf="@id/llBottom"
            app:layout_constraintDimensionRatio="3.28:0.44"
        >

            <androidx.cardview.widget.CardView
                android:id="@+id/btnWhatsapp"
                android:elevation="@dimen/dimension_0"
                app:cardElevation="@dimen/dimension_0"
                android:layout_width="@dimen/dimension_0"
                android:layout_height="match_parent"
                android:layout_weight="156"
                app:cardBackgroundColor="@color/app_color2"
                app:cardCornerRadius="@dimen/dimension_10">

                <androidx.cardview.widget.CardView
                    android:elevation="@dimen/dimension_0"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="@dimen/dimension_1"
                    app:cardBackgroundColor="@color/app_color3"
                    app:cardCornerRadius="@dimen/dimension_10"
                    app:cardElevation="@dimen/dimension_0">
                    <androidx.cardview.widget.CardView
                        android:elevation="@dimen/dimension_0"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginBottom="@dimen/dimension_3"
                        app:cardBackgroundColor="@color/app_color4"
                        app:cardCornerRadius="@dimen/dimension_10"
                        app:cardElevation="@dimen/dimension_0">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/btnWhatsapp2"
                            android:background="@color/app_color8"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <View
                                android:id="@+id/view3"
                                android:layout_width="@dimen/dimension_0"
                                android:layout_height="match_parent"
                                app:layout_constraintDimensionRatio="0.8:4.4"
                                app:layout_constraintStart_toStartOf="parent"/>

                            <View
                                android:id="@+id/view4"
                                android:layout_width="@dimen/dimension_0"
                                android:layout_height="match_parent"
                                app:layout_constraintDimensionRatio="0.8:4.4"
                                app:layout_constraintEnd_toEndOf="parent"/>
                            <ImageView
                                android:id="@+id/img_WhatApp"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                android:layout_marginVertical="@dimen/dimension_14"
                                android:src="@drawable/ic_whatapp"
                                android:layout_width="@dimen/dimension_0" android:layout_height="@dimen/dimension_0"
                                app:layout_constraintDimensionRatio="1"
                                app:layout_constraintStart_toEndOf="@+id/view3"/>
                            <TextView
                                android:layout_marginStart="@dimen/dimension_3"
                                android:id="@+id/tvWhatApp"
                                style="@style/single_marquee"
                                android:layout_width="@dimen/dimension_0"
                                android:layout_height="match_parent"
                                android:layout_gravity="center"
                                android:fontFamily="@font/outfit_semi_bold"
                                android:gravity="center"
                                android:text="@string/add_to_whatsapp"
                                android:textColor="@color/white"
                                android:textSize="@dimen/text_size_16"
                                app:layout_constraintEnd_toStartOf="@+id/view4"
                                app:layout_constraintStart_toEndOf="@+id/img_WhatApp"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>

                    </androidx.cardview.widget.CardView>
                </androidx.cardview.widget.CardView>
            </androidx.cardview.widget.CardView>

            <Space
                android:layout_width="@dimen/dimension_0"
                android:layout_height="match_parent"
                android:layout_weight="16"/>

            <androidx.cardview.widget.CardView
                android:id="@+id/btnTelegram"
                app:cardBackgroundColor="@color/app_color2"
                app:cardCornerRadius="@dimen/dimension_10"
                android:layout_width="@dimen/dimension_0"
                android:layout_height="match_parent"
                android:layout_weight="156"
                android:elevation="@dimen/dimension_0"
                app:cardElevation="@dimen/dimension_0"
            >

                <androidx.cardview.widget.CardView
                    android:elevation="@dimen/dimension_0"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="@dimen/dimension_1"
                    app:cardBackgroundColor="@color/app_color3"
                    app:cardCornerRadius="@dimen/dimension_10"
                    app:cardElevation="@dimen/dimension_0">
                    <androidx.cardview.widget.CardView
                        android:elevation="@dimen/dimension_0"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginBottom="@dimen/dimension_3"
                        app:cardBackgroundColor="@color/app_color4"
                        app:cardCornerRadius="@dimen/dimension_10"
                        app:cardElevation="@dimen/dimension_0">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/btnTelegram2"
                            android:background="@color/app_color9"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <View
                                android:id="@+id/view1"
                                android:layout_width="@dimen/dimension_0"
                                android:layout_height="match_parent"
                                app:layout_constraintDimensionRatio="0.8:4.4"
                                app:layout_constraintStart_toStartOf="parent"/>

                            <View
                                android:id="@+id/view2"
                                android:layout_width="@dimen/dimension_0"
                                android:layout_height="match_parent"
                                app:layout_constraintDimensionRatio="0.8:4.4"
                                app:layout_constraintEnd_toEndOf="parent"/>
                            <ImageView
                                android:id="@+id/img_Telegram"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                android:layout_marginVertical="@dimen/dimension_14"
                                android:src="@drawable/ic_telegram"
                                android:layout_width="@dimen/dimension_0"
                                android:layout_height="@dimen/dimension_0"
                                app:layout_constraintDimensionRatio="1"
                                app:layout_constraintStart_toEndOf="@+id/view1"/>
                            <TextView
                                android:id="@+id/tvTelegram"
                                style="@style/single_marquee"
                                android:layout_width="@dimen/dimension_0"
                                android:layout_height="match_parent"
                                android:layout_gravity="center"
                                android:fontFamily="@font/outfit_semi_bold"
                                android:gravity="center"
                                android:text="@string/add_to_telegram"
                                android:textColor="@color/white"
                                android:textSize="@dimen/text_size_16"
                                app:layout_constraintEnd_toStartOf="@+id/view2"
                                app:layout_constraintStart_toEndOf="@+id/img_Telegram"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.cardview.widget.CardView>
                </androidx.cardview.widget.CardView>
            </androidx.cardview.widget.CardView>

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/llBottom"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimension_0"
            android:layout_marginHorizontal="@dimen/dimension_8"
            android:layout_marginBottom="@dimen/dimension_8"
            android:orientation="horizontal"
            android:visibility="gone"
            android:weightSum="328"
            app:layout_constraintBottom_toTopOf="@+id/bottomview"
            app:layout_constraintDimensionRatio="3.28:0.44">

            <androidx.cardview.widget.CardView
                android:id="@+id/btnShare"
                android:layout_width="@dimen/dimension_0"
                android:layout_height="match_parent"
                android:layout_weight="156"
                app:cardBackgroundColor="@color/app_color2"
                app:cardCornerRadius="@dimen/dimension_10"
                android:elevation="@dimen/dimension_0"
                app:cardElevation="@dimen/dimension_0"
            >

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="@dimen/dimension_1"
                    app:cardBackgroundColor="@color/app_color3"
                    app:cardCornerRadius="@dimen/dimension_10"
                    android:elevation="@dimen/dimension_0"
                    app:cardElevation="@dimen/dimension_0">
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginBottom="@dimen/dimension_3"
                        app:cardBackgroundColor="@color/app_color4"
                        app:cardCornerRadius="@dimen/dimension_10"
                        android:elevation="@dimen/dimension_0"
                        app:cardElevation="@dimen/dimension_0">

                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginBottom="@dimen/dimension_1"
                            app:cardBackgroundColor="@color/transparent"
                            app:cardCornerRadius="@dimen/dimension_10"
                            android:elevation="@dimen/dimension_0"
                            app:cardElevation="@dimen/dimension_0">


                            <TextView
                                android:background="@drawable/bg_linear_color"
                                style="@style/single_marquee"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:fontFamily="@font/jockey_one_regular"
                                android:gravity="center"
                                android:text="@string/share"
                                android:textColor="@color/app_color"
                                android:textSize="@dimen/text_size_20"/>
                        </androidx.cardview.widget.CardView>
                    </androidx.cardview.widget.CardView>
                </androidx.cardview.widget.CardView>
            </androidx.cardview.widget.CardView>

            <Space
                android:layout_width="@dimen/dimension_0"
                android:layout_height="match_parent"
                android:layout_weight="16"/>

            <androidx.cardview.widget.CardView
                android:id="@+id/btnDownload"
                android:layout_width="@dimen/dimension_0"
                android:layout_height="match_parent"
                android:layout_weight="156"
                app:cardBackgroundColor="@color/app_color2"
                app:cardCornerRadius="@dimen/dimension_10"
                android:elevation="@dimen/dimension_0"
                app:cardElevation="@dimen/dimension_0">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="@dimen/dimension_1"
                    app:cardBackgroundColor="@color/app_color3"
                    app:cardCornerRadius="@dimen/dimension_10"
                    android:elevation="@dimen/dimension_0"
                    app:cardElevation="@dimen/dimension_0">
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginBottom="@dimen/dimension_3"
                        app:cardBackgroundColor="@color/app_color4"
                        app:cardCornerRadius="@dimen/dimension_10"
                        android:elevation="@dimen/dimension_0"
                        app:cardElevation="@dimen/dimension_0">

                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginBottom="@dimen/dimension_1"
                            app:cardBackgroundColor="@color/transparent"
                            app:cardCornerRadius="@dimen/dimension_10"
                            android:elevation="@dimen/dimension_0"
                            app:cardElevation="@dimen/dimension_0">


                            <TextView
                                android:background="@drawable/bg_linear_color"
                                style="@style/single_marquee"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:fontFamily="@font/jockey_one_regular"
                                android:gravity="center"
                                android:text="@string/download"
                                android:textColor="@color/app_color"
                                android:textSize="@dimen/text_size_20"/>
                        </androidx.cardview.widget.CardView>
                    </androidx.cardview.widget.CardView>
                </androidx.cardview.widget.CardView>
            </androidx.cardview.widget.CardView>
        </androidx.appcompat.widget.LinearLayoutCompat>


    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

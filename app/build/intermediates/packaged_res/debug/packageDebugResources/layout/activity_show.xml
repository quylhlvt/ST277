                    android:id="@+id/mater"
                    android:layout_width="@dimen/dimension_0"
                    android:layout_height="@dimen/dimension_0"
                    android:layout_marginHorizontal="@dimen/dimension_22"
                    android:elevation="@dimen/dimension_2"
                    app:cardBackgroundColor="@color/app_color2"
                    app:cardCornerRadius="@dimen/dimension_20"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintDimensionRatio="2.87:2.57"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:strokeColor="@color/app_color"
                    app:strokeWidth="@dimen/dimension_3">

                <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="@dimen/dimension_10"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="@dimen/dimension_10"
                        app:strokeColor="@color/app_color"
                        app:strokeWidth="@dimen/dimension_2">

                    <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                        <View
                                android:id="@+id/view"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/dimension_0"
                                app:layout_constraintDimensionRatio="2.87:0.51"
                                app:layout_constraintTop_toTopOf="parent"/>

                        <com.willy.ratingbar.ScaleRatingBar
                                android:id="@+id/ll1"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="@dimen/dimension_11"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/view"
                                app:srb_clearRatingEnabled="false"
                                app:srb_clickable="false"
                                app:srb_drawableEmpty="@drawable/ic_unrate_show"
                                app:srb_drawableFilled="@drawable/ic_rate_success"
                                app:srb_isIndicator="true"
                                app:srb_minimumStars="0"
                                app:srb_numStars="5"
                                app:srb_rating="0"
                                app:srb_scrollable="false"
                                app:srb_starHeight="@dimen/dimension_40"
                                app:srb_starPadding="@dimen/dimension_4"
                                app:srb_starWidth="@dimen/dimension_40"
                                app:srb_stepSize="1"/>

                        <TextView
                                android:id="@+id/txtNextDialog"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/pacifico_regular"
                                android:gravity="center"
                                style="@style/single_marquee"
                                android:paddingHorizontal="@dimen/dimension_5"
                                android:text="@string/cosplay_complete"
                                android:textColor="@color/app_color2"
                                android:textSize="@dimen/text_size_20"
                                app:layout_constraintBottom_toTopOf="@+id/frameNextDialog"
                                app:layout_constraintTop_toBottomOf="@+id/ll1"/>

                        <androidx.constraintlayout.widget.ConstraintLayout
                                android:id="@+id/frameNextDialog"
                                android:layout_width="@dimen/dimension_0"
                                android:layout_height="@dimen/dimension_0"
                                android:layout_marginHorizontal="@dimen/dimension_65"
                                android:layout_marginBottom="@dimen/dimension_28"
                                android:background="@drawable/bg_btn_next_show"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintDimensionRatio="1.54:0.44"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent">

                            <TextView
                                    android:id="@+id/txtNext"
                                    style="@style/single_marquee"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginHorizontal="@dimen/dimension_7"
                                    android:fontFamily="@font/pacifico_regular"
                                    android:gravity="center"
                                    app:layout_constraintTop_toTopOf="parent"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    android:layout_marginBottom="@dimen/dimension_10"
                                    android:text="@string/next"
                                    android:textColor="@color/app_color"
                                    android:textSize="@dimen/text_size_20"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>
            </com.google.android.material.card.MaterialCardView>
        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>


    <FrameLayout
            android:id="@+id/countDown"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#99000000"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:visibility="gone">

        <TextView
                android:id="@+id/tvCountDown"
                android:layout_width="@dimen/dimension_50"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/baloo2_bold"
                android:gravity="center"
                android:text="3"
                android:textColor="@color/app_color5"
                android:textSize="@dimen/text_size_50"/>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

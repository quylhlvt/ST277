<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/img_bg_splash"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:context="com.duomaker.couplelove.vatar.ui.main.view.ViewActivity">
    <FrameLayout
        android:id="@+id/layoutActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/actionBar"
            layout="@layout/layout_actionbar4"/>
    </FrameLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimension_0"
        android:layout_marginBottom="@dimen/dimension_0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutActionBar">
        <!--        <androidx.constraintlayout.widget.Guideline-->
        <!--                android:layout_width="wrap_content" android:layout_height="wrap_content"-->
        <!--                                                    android:orientation="horizontal"-->
        <!--                                                    app:layout_constraintGuide_percent="0.65"/>-->

            <ImageView
                android:id="@+id/imvImage"
                android:layout_width="@dimen/dimension_0"
                android:layout_height="@dimen/dimension_0"
                app:layout_constraintBottom_toTopOf="@+id/lnlBottom"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:src="@drawable/img_permission"/>

        <View
            android:id="@+id/bottomview"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimension_32"
            app:layout_constraintBottom_toBottomOf="parent"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/lnlBottom"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimension_0"
            android:layout_marginHorizontal="@dimen/dimension_8"
            android:layout_marginBottom="@dimen/dimension_8"
            android:orientation="horizontal"
            android:weightSum="328"
            app:layout_constraintBottom_toTopOf="@id/llBottom"
            app:layout_constraintDimensionRatio="3.28:0.44"
        >

            <androidx.cardview.widget.CardView
                android:id="@+id/btnFacebook"
                android:elevation="@dimen/dimension_0"
                app:cardElevation="@dimen/dimension_0"
                android:layout_width="@dimen/dimension_0"
                android:layout_height="match_parent"
                android:layout_weight="156"
                app:cardBackgroundColor="@color/app_color2"
                app:cardCornerRadius="@dimen/dimension_10"
               >

                <androidx.cardview.widget.CardView
                    android:elevation="@dimen/dimension_0"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="@dimen/dimension_1"
                    app:cardBackgroundColor="@color/app_color3"
                    app:cardCornerRadius="@dimen/dimension_10"
                    app:cardElevation="@dimen/dimension_0">
                    <androidx.cardview.widget.CardView
                        android:elevation="@dimen/dimension_0"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginBottom="@dimen/dimension_3"
                        app:cardBackgroundColor="@color/app_color4"
                        app:cardCornerRadius="@dimen/dimension_10"
                        app:cardElevation="@dimen/dimension_0">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:background="@color/app_color10"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <View
                                android:id="@+id/view3"
                                android:layout_width="@dimen/dimension_0"
                                android:layout_height="match_parent"
                                app:layout_constraintDimensionRatio="0.8:4.4"
                                app:layout_constraintStart_toStartOf="parent"/>

                            <View
                                android:id="@+id/view4"
                                android:layout_width="@dimen/dimension_0"
                                android:layout_height="match_parent"
                                app:layout_constraintDimensionRatio="0.8:4.4"
                                app:layout_constraintEnd_toEndOf="parent"/>
                            <ImageView
                                android:id="@+id/img_Facebook"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                android:layout_marginVertical="@dimen/dimension_14"
                                android:src="@drawable/ic_fb"
                                android:layout_width="@dimen/dimension_0" android:layout_height="@dimen/dimension_0"
                                app:layout_constraintDimensionRatio="1"
                                app:layout_constraintStart_toEndOf="@+id/view3"/>
                            <TextView
                                android:layout_marginStart="@dimen/dimension_3"
                                android:id="@+id/tvFacebook"
                                style="@style/single_marquee"
                                android:layout_width="@dimen/dimension_0"
                                android:layout_height="match_parent"
                                android:layout_gravity="center"
                                android:fontFamily="@font/outfit_semi_bold"
                                android:gravity="center"
                                android:text="@string/facebook_share"
                                android:textColor="@color/white"
                                android:textSize="@dimen/text_size_16"
                                app:layout_constraintEnd_toStartOf="@+id/view4"
                                app:layout_constraintStart_toEndOf="@+id/img_Facebook"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>

                    </androidx.cardview.widget.CardView>
                </androidx.cardview.widget.CardView>
            </androidx.cardview.widget.CardView>

            <Space
                android:layout_width="@dimen/dimension_0"
                android:layout_height="match_parent"
                android:layout_weight="16"/>

            <androidx.cardview.widget.CardView
                android:id="@+id/btnInstagram"
                app:cardBackgroundColor="@color/app_color2"
                app:cardCornerRadius="@dimen/dimension_10"
                android:layout_width="@dimen/dimension_0"
                android:layout_height="match_parent"
                android:layout_weight="156"
                android:elevation="@dimen/dimension_0"
                app:cardElevation="@dimen/dimension_0"
            >

                <androidx.cardview.widget.CardView
                    android:elevation="@dimen/dimension_0"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="@dimen/dimension_1"
                    app:cardBackgroundColor="@color/app_color3"
                    app:cardCornerRadius="@dimen/dimension_10"
                    app:cardElevation="@dimen/dimension_0">
                    <androidx.cardview.widget.CardView
                        android:elevation="@dimen/dimension_0"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginBottom="@dimen/dimension_3"
                        app:cardBackgroundColor="@color/app_color4"
                        app:cardCornerRadius="@dimen/dimension_10"
                        app:cardElevation="@dimen/dimension_0">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:background="@drawable/bg_ig"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <View
                                android:id="@+id/view1"
                                android:layout_width="@dimen/dimension_0"
                                android:layout_height="match_parent"
                                app:layout_constraintDimensionRatio="0.8:4.4"
                                app:layout_constraintStart_toStartOf="parent"/>

                            <View
                                android:id="@+id/view2"
                                android:layout_width="@dimen/dimension_0"
                                android:layout_height="match_parent"
                                app:layout_constraintDimensionRatio="0.8:4.4"
                                app:layout_constraintEnd_toEndOf="parent"/>
                            <ImageView
                                android:id="@+id/img_Instagram"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                android:layout_marginVertical="@dimen/dimension_14"
                                android:src="@drawable/ic_fb"
                                android:layout_width="@dimen/dimension_0"
                                android:layout_height="@dimen/dimension_0"
                                app:layout_constraintDimensionRatio="1"
                                app:layout_constraintStart_toEndOf="@+id/view1"/>
                            <TextView
                                android:id="@+id/tvInstagram"
                                style="@style/single_marquee"
                                android:layout_width="@dimen/dimension_0"
                                android:layout_height="match_parent"
                                android:layout_gravity="center"
                                android:fontFamily="@font/outfit_semi_bold"
                                android:gravity="center"
                                android:text="@string/instagram_share"
                                android:textColor="@color/white"
                                android:textSize="@dimen/text_size_16"
                                app:layout_constraintEnd_toStartOf="@+id/view2"
                                app:layout_constraintStart_toEndOf="@+id/img_Instagram"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.cardview.widget.CardView>
                </androidx.cardview.widget.CardView>
            </androidx.cardview.widget.CardView>

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/llBottom"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimension_0"
            android:layout_marginHorizontal="@dimen/dimension_8"
            android:layout_marginBottom="@dimen/dimension_8"
            android:orientation="horizontal"
            android:weightSum="328"
            app:layout_constraintBottom_toTopOf="@+id/bottomview"
            app:layout_constraintDimensionRatio="3.28:0.44">

            <androidx.cardview.widget.CardView
                android:id="@+id/btnShare"
                android:layout_width="@dimen/dimension_0"
                android:layout_height="match_parent"
                android:layout_weight="156"
                app:cardBackgroundColor="@color/app_color2"
                app:cardCornerRadius="@dimen/dimension_10"
                android:elevation="@dimen/dimension_0"
                app:cardElevation="@dimen/dimension_0"
            >

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="@dimen/dimension_1"
                    app:cardBackgroundColor="@color/app_color3"
                    app:cardCornerRadius="@dimen/dimension_10"
                    android:elevation="@dimen/dimension_0"
                    app:cardElevation="@dimen/dimension_0">
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginBottom="@dimen/dimension_3"
                        app:cardBackgroundColor="@color/app_color4"
                        app:cardCornerRadius="@dimen/dimension_10"
                        android:elevation="@dimen/dimension_0"
                        app:cardElevation="@dimen/dimension_0">

                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginBottom="@dimen/dimension_1"
                            app:cardBackgroundColor="@color/transparent"
                            app:cardCornerRadius="@dimen/dimension_10"
                            android:elevation="@dimen/dimension_0"
                            app:cardElevation="@dimen/dimension_0">


                            <TextView
                                android:background="@drawable/bg_linear_color"
                                style="@style/single_marquee"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:fontFamily="@font/jockey_one_regular"
                                android:gravity="center"
                                android:text="@string/share"
                                android:textColor="@color/app_color"
                                android:textSize="@dimen/text_size_20"/>
                        </androidx.cardview.widget.CardView>
                    </androidx.cardview.widget.CardView>
                </androidx.cardview.widget.CardView>
            </androidx.cardview.widget.CardView>

            <Space
                android:layout_width="@dimen/dimension_0"
                android:layout_height="match_parent"
                android:layout_weight="16"/>

            <androidx.cardview.widget.CardView
                android:id="@+id/btnDownload"
                android:layout_width="@dimen/dimension_0"
                android:layout_height="match_parent"
                android:layout_weight="156"
                app:cardBackgroundColor="@color/app_color2"
                app:cardCornerRadius="@dimen/dimension_10"
                android:elevation="@dimen/dimension_0"
                app:cardElevation="@dimen/dimension_0">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="@dimen/dimension_1"
                    app:cardBackgroundColor="@color/app_color3"
                    app:cardCornerRadius="@dimen/dimension_10"
                    android:elevation="@dimen/dimension_0"
                    app:cardElevation="@dimen/dimension_0">
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginBottom="@dimen/dimension_3"
                        app:cardBackgroundColor="@color/app_color4"
                        app:cardCornerRadius="@dimen/dimension_10"
                        android:elevation="@dimen/dimension_0"
                        app:cardElevation="@dimen/dimension_0">

                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginBottom="@dimen/dimension_1"
                            app:cardBackgroundColor="@color/transparent"
                            app:cardCornerRadius="@dimen/dimension_10"
                            android:elevation="@dimen/dimension_0"
                            app:cardElevation="@dimen/dimension_0">


                            <TextView
                                android:background="@drawable/bg_linear_color"
                                style="@style/single_marquee"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:fontFamily="@font/jockey_one_regular"
                                android:gravity="center"
                                android:text="@string/download"
                                android:textColor="@color/app_color"
                                android:textSize="@dimen/text_size_20"/>
                        </androidx.cardview.widget.CardView>
                    </androidx.cardview.widget.CardView>
                </androidx.cardview.widget.CardView>
            </androidx.cardview.widget.CardView>
        </androidx.appcompat.widget.LinearLayoutCompat>


    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/app_color2"
        tools:context="com.duomaker.couplelove.vatar.ui.main.cosplay.CosplayActivity">
    <View
            android:id="@+id/view1"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimension_0"
            app:layout_constraintDimensionRatio="3.6:0.44"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="@dimen/dimension_0"/>
    <com.google.android.material.card.MaterialCardView
            android:layout_width="@dimen/dimension_0"
            android:layout_height="@dimen/dimension_0"
            android:id="@+id/material"
            app:layout_constraintDimensionRatio="1:1"
            android:layout_margin="@dimen/dimension_16"
            app:cardCornerRadius="@dimen/dimension_4"
            app:strokeColor="@color/black"
            app:cardBackgroundColor="@color/white"
            app:strokeWidth="@dimen/dimension_1"
            app:layout_constraintTop_toBottomOf="@+id/layoutActionBar"
            app:layout_constraintBottom_toTopOf="@+id/view1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintVertical_bias="0">

        <ImageView
                android:id="@+id/imvImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/img_permission"/>
        <ImageView
                android:id="@+id/imageGif"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:visibility="gone"/>
    </com.google.android.material.card.MaterialCardView>


    <FrameLayout
            android:id="@+id/layoutActionBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent">

        <include
                android:id="@+id/actionBar"
                layout="@layout/layout_actionbar4"/>
    </FrameLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimension_0"
            android:id="@+id/contrain"
            android:layout_marginTop="@dimen/dimension_16"
            app:layout_constraintDimensionRatio="3.6:0.44"
            app:layout_constraintTop_toBottomOf="@+id/material"
    >

        <View
                android:id="@+id/view2"
                android:layout_width="@dimen/dimension_0"
                android:layout_height="match_parent"
                app:layout_constraintDimensionRatio="1.8:4.4"
                app:layout_constraintStart_toStartOf="parent"/>

        <View
                android:id="@+id/view3"
                android:layout_width="@dimen/dimension_0"
                android:layout_height="match_parent"
                app:layout_constraintDimensionRatio="1.8:4.4"
                app:layout_constraintEnd_toEndOf="parent"/>

        <View
                android:id="@+id/view4"
                android:layout_width="@dimen/dimension_0"
                android:layout_height="match_parent"
                app:layout_constraintDimensionRatio="1.6:4.4"
                app:layout_constraintEnd_toStartOf="@+id/show"
                app:layout_constraintStart_toEndOf="@+id/random"/>


        <com.google.android.material.card.MaterialCardView
                android:id="@+id/random"
                android:layout_width="@dimen/dimension_0"
                android:layout_height="@dimen/dimension_0"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:cardCornerRadius="@dimen/dimension_16"
                app:cardBackgroundColor="@color/app_color2"
                app:strokeColor="@color/black"
                app:strokeWidth="@dimen/dimension_1"
                app:layout_constraintDimensionRatio="1.54:0.44"
                app:layout_constraintEnd_toStartOf="@+id/view4"
                app:layout_constraintStart_toEndOf="@+id/view2">
            <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="@dimen/dimension_4"
                    app:strokeWidth="@dimen/dimension_0"
                    app:cardCornerRadius="@dimen/dimension_12"
                    app:cardBackgroundColor="@color/app_color4">
                <TextView
                        android:id="@+id/txtRandom"
                        style="@style/single_marquee"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fontFamily="@font/schoolbell_regular"
                        android:gravity="center"
                        android:text="@string/random"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_size_16"/>

            </com.google.android.material.card.MaterialCardView>
        </com.google.android.material.card.MaterialCardView>


        <com.google.android.material.card.MaterialCardView
                android:id="@+id/show"
                android:layout_width="@dimen/dimension_0"
                android:layout_height="@dimen/dimension_0"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:cardCornerRadius="@dimen/dimension_16"
                app:cardBackgroundColor="@color/app_color2"
                app:strokeColor="@color/black"
                android:alpha="0.5"
                app:strokeWidth="@dimen/dimension_1"
                app:layout_constraintDimensionRatio="1.54:0.44"
                app:layout_constraintEnd_toStartOf="@+id/view3"
                app:layout_constraintStart_toEndOf="@+id/view4">
            <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="@dimen/dimension_4"
                    app:strokeWidth="@dimen/dimension_0"
                    app:cardCornerRadius="@dimen/dimension_12"
                    app:cardBackgroundColor="@color/app_color4">
                <TextView
                        android:id="@+id/txtShow"
                        style="@style/single_marquee"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fontFamily="@font/schoolbell_regular"
                        android:gravity="center"
                        android:text="@string/cosplay2"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_size_16"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
            </com.google.android.material.card.MaterialCardView>
        </com.google.android.material.card.MaterialCardView>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
            android:id="@+id/showGuide"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#99000000"
            android:clickable="true"
            android:clipChildren="true"
            android:clipToOutline="true"
            android:orientation="vertical"
            android:gravity="center"
            android:clipToPadding="false"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:visibility="gone">
        <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dimension_16">
            <View
                    android:id="@+id/viewTittle1"
                    android:layout_width="match_parent"

                    android:layout_height="@dimen/dimension_0"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintDimensionRatio="3.12:0.2"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/contrainTittle"
                    android:elevation="@dimen/dimension_4"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dimension_0"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintDimensionRatio="3.12:0.4">
                <com.google.android.material.card.MaterialCardView
                        android:layout_width="@dimen/dimension_0"
                        android:layout_height="@dimen/dimension_0"
                        app:layout_constraintDimensionRatio="1.56:0.4"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:strokeColor="@color/app_color"
                        app:strokeWidth="@dimen/dimension_1"
                        app:cardCornerRadius="@dimen/dimension_100"
                        app:cardBackgroundColor="@color/app_color4"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                    <TextView
                            android:id="@+id/txtTilleShow"
                            style="@style/single_marquee"
                            android:layout_width="match_parent"
                            android:layout_marginHorizontal="@dimen/dimension_3"
                            android:layout_height="match_parent"
                            android:fontFamily="@font/schoolbell_regular"
                            android:gravity="center"
                            android:text="@string/instruction"
                            android:textColor="@color/white"
                            android:textSize="@dimen/text_size_16"/>
                </com.google.android.material.card.MaterialCardView>

            </androidx.constraintlayout.widget.ConstraintLayout>


            <com.google.android.material.card.MaterialCardView
                    app:layout_constraintTop_toBottomOf="@+id/viewTittle1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="@dimen/dimension_16"
                    android:elevation="@dimen/dimension_3"
                    app:strokeWidth="@dimen/dimension_1"
                    app:strokeColor="@color/app_color"
                    android:layout_marginBottom="@dimen/dimension_8"
                    app:cardBackgroundColor="@color/app_color2">


                <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:clipChildren="false"
                        android:clipToOutline="false"
                        android:clipToPadding="false">
                    <View
                            android:id="@+id/viewContext1"
                            android:layout_width="match_parent"

                            android:layout_height="@dimen/dimension_0"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintDimensionRatio="3.12:0.2"/>
                    <FrameLayout
                            android:id="@+id/frameLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dimension_8"
                            android:layout_marginHorizontal="@dimen/dimension_16"
                            android:clipChildren="false"
                            android:paddingBottom="@dimen/dimension_16"
                            android:clipToPadding="false"
                            app:layout_constraintTop_toBottomOf="@+id/viewContext1">

                        <!--                android:lineSpacingMultiplier="0.8"-->

                        <TextView
                                android:id="@+id/txtGuile"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:fontFamily="@font/schoolbell_regular"
                                android:gravity="center"
                                android:text="@string/players_receive_a_random"
                                android:textColor="@color/app_color"
                                android:textSize="@dimen/text_size_16"
                        />
                    </FrameLayout>


                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/closeGuide"
                android:layout_marginTop="@dimen/dimension_20"
                android:layout_width="@dimen/dimension_44"
                android:layout_height="@dimen/dimension_44"

                android:src="@drawable/ic_close_guide"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/img_bg_success_cosplay"
        android:clipChildren="false"
        android:clipToPadding="false"
        tools:context="com.duomaker.couplelove.vatar.ui.main.successcosplay.SuccessCosplayActivity">

    <FrameLayout
            android:id="@+id/layoutActionBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent">

        <include
                android:id="@+id/actionBar"
                layout="@layout/layout_actionbar4"/>
    </FrameLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimension_0"
            android:layout_marginBottom="@dimen/dimension_0"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layoutActionBar">
        <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/constraint"
                android:layout_width="@dimen/dimension_0"
                android:layout_height="@dimen/dimension_0"
                android:layout_marginTop="@dimen/dimension_36"
                android:layout_marginHorizontal="@dimen/dimension_56"
                app:layout_constraintDimensionRatio="2.4:2.88"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.card.MaterialCardView
                    android:layout_width="@dimen/dimension_0"
                    android:layout_height="@dimen/dimension_0"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="@dimen/dimension_8"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:strokeColor="@color/app_color"
                    app:strokeWidth="@dimen/dimension_0">

                <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                    <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardImgBig"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dimension_0"
                            app:cardBackgroundColor="@color/white"
                            app:cardCornerRadius="@dimen/dimension_0"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintDimensionRatio="1"
                            android:layout_margin="@dimen/dimension_16"
                            app:strokeWidth="@dimen/dimension_0">

                        <ImageView
                                android:id="@+id/imageGif"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:elevation="@dimen/dimension_2"/>

                        <ImageView
                                android:id="@+id/imvImage"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:elevation="@dimen/dimension_1"
                                android:scaleType="centerCrop"
                                android:src="@drawable/img_permission"/>
                    </com.google.android.material.card.MaterialCardView>
                    <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="@dimen/dimension_0"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/cardImgBig"
                            android:layout_height="@dimen/dimension_0"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            android:layout_marginHorizontal="@dimen/dimension_32"
                            android:layout_marginVertical="@dimen/dimension_8"
                            app:layout_constraintDimensionRatio="1.76:0.48">
                        <ImageView
                                android:id="@+id/occupy1"
                                android:layout_width="@dimen/dimension_0"
                                android:layout_height="@dimen/dimension_0"
                                app:layout_constraintDimensionRatio="1:1"
                                android:src="@drawable/img_unoccupy"
                                app:layout_constraintEnd_toStartOf="@+id/occupy2"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"/>
                        <ImageView
                                android:id="@+id/occupy2"
                                android:layout_width="@dimen/dimension_0"
                                android:layout_height="@dimen/dimension_0"
                                app:layout_constraintDimensionRatio="1:1"
                                android:src="@drawable/img_unoccupy"
                                app:layout_constraintEnd_toStartOf="@+id/occupy3"
                                app:layout_constraintStart_toEndOf="@+id/occupy1"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"/>
                        <ImageView
                                android:id="@+id/occupy3"
                                android:layout_width="@dimen/dimension_0"
                                android:layout_height="@dimen/dimension_0"
                                app:layout_constraintDimensionRatio="1:1"
                                android:src="@drawable/img_unoccupy"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toEndOf="@+id/occupy2"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>
        </androidx.constraintlayout.widget.ConstraintLayout>


        <com.google.android.material.card.MaterialCardView
                app:layout_constraintTop_toBottomOf="@+id/constraint"
                app:layout_constraintDimensionRatio="3.28:0.44"
                android:id="@+id/btnDownload"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:strokeColor="@color/black"
                app:strokeWidth="@dimen/dimension_1"
                android:layout_marginTop="@dimen/dimension_36"
                android:layout_marginHorizontal="@dimen/dimension_16"
                app:cardCornerRadius="@dimen/dimension_16"
                app:cardBackgroundColor="@color/app_color2">
            <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="@dimen/dimension_4"
                    app:strokeWidth="@dimen/dimension_0"
                    app:cardCornerRadius="@dimen/dimension_14"
                    app:cardBackgroundColor="@color/app_color4">
                <TextView
                        android:id="@+id/txtDownload"
                        android:layout_width="match_parent" android:layout_height="match_parent"
                        android:textSize="@dimen/text_size_16"
                        android:textColor="@color/white"
                        android:text="@string/download"
                        android:gravity="center"
                        android:fontFamily="@font/schoolbell_regular"/>
            </com.google.android.material.card.MaterialCardView>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/dimension_8"
    android:layout_marginBottom="@dimen/dimension_16"
    android:background="@color/transparent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimension_0"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintTop_toTopOf="parent">


        <com.google.android.material.card.MaterialCardView
            android:layout_width="@dimen/dimension_0"
            android:layout_height="@dimen/dimension_0"
            app:cardBackgroundColor="@color/app_color2"
            app:cardCornerRadius="@dimen/dimension_20"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeColor="@color/app_color"
            app:strokeWidth="@dimen/dimension_3">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_marginHorizontal="@dimen/dimension_3"
                android:layout_marginBottom="@dimen/dimension_7"
                android:layout_height="match_parent">
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    app:cardBackgroundColor="@color/white"
                    app:strokeColor="@color/app_color4"
                    app:cardCornerRadius="@dimen/dimension_17"
                    app:strokeWidth="@dimen/dimension_0"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/imvImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:foreground="@drawable/forgound_item_mycreation"
                        android:src="@drawable/img_permission" />
                    <View
                        android:id="@+id/showDownSelect"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/black6"/>


                </com.google.android.material.card.MaterialCardView>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>



        <ImageView
            android:id="@+id/btnDelete"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_width="@dimen/dimension_30"
            android:layout_height="@dimen/dimension_30"
            android:src="@drawable/ic_delete1" />


        <!--        btnSelect-->
        <ImageView
            android:id="@+id/btnSelect"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_width="@dimen/dimension_30"
            android:layout_height="@dimen/dimension_30"
            android:src="@drawable/ic_not_select"
            android:visibility="gone" />

    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>

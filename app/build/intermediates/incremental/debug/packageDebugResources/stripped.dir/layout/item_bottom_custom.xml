<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:layout_marginVertical="@dimen/dimension_6"
    android:layout_marginEnd="@dimen/dimension_8">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/frame1"
        android:layout_width="@dimen/dimension_0"
        android:layout_height="match_parent"
        android:elevation="@dimen/dimension_2"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/dimension_6"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeWidth="@dimen/dimension_0">





            <ImageView
                android:id="@+id/imvImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:background="@color/transparent"
                android:scaleType="fitXY" />


            <!--            imvImage-->


            <!--        sflShimmer-->


        </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/forcus"
        android:visibility="invisible"
        android:layout_width="@dimen/dimension_0"
        android:layout_height="@dimen/dimension_0"
        app:cardBackgroundColor="@color/transparent"
        app:cardCornerRadius="@dimen/dimension_6"
        app:layout_constraintStart_toStartOf="@+id/frame1"
        app:layout_constraintEnd_toEndOf="@+id/frame1"
        app:layout_constraintBottom_toBottomOf="@+id/frame1"
        app:layout_constraintTop_toTopOf="@+id/frame1"
        app:strokeColor="@color/app_color"
        app:strokeWidth="@dimen/dimension_3"/>

</androidx.constraintlayout.widget.ConstraintLayout>
